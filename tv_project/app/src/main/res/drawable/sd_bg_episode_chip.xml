<?xml version="1.0" encoding="utf-8"?>
<!--
  选集网格单元底：普通 / 当前集两种状态。
  颜色全部复用 colors.xml 里已经存在的 episode_chip_* 系列，不新增颜色名，
  保证选集面板和 App 其它选集入口看起来是同一套东西。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/episode_chip_bg_selected" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/episode_chip_bg" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
