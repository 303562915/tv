<?xml version="1.0" encoding="utf-8"?>
<!--
  「还没起名字」小徽标底：对照 unicanta SettingsScreen.UserCard 里
  9sp 文字 + RoundedCornerShape(50) + #FFE96B(45% alpha) 的胶囊。
  这里用实色 #FFFFE96B 的整圆角矩形，颜色由文字 #FF6B5400 压住。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFE96B" />
    <corners android:radius="50dp" />
</shape>