<?xml version="1.0" encoding="utf-8"?>
<!--
  选集面板里每一行的底：当前集用主色描边 + 主色浅底，其它行只有一条很淡的分隔线。
  为什么用 selector 而不是在代码里 setBackgroundColor：列表滚动复用时
  isSelected 一变，状态图自动换，不需要在 onBindViewHolder 里再判一次。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_selected_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/theme_primary" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/theme_divider" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
