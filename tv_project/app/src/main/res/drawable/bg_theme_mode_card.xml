<?xml version="1.0" encoding="utf-8"?>
<!--
  「外观主题」页专用：夜间模式选择卡（未选中态）。
  8dp 圆角（radius_sm），不用 16dp —— 56dp 高配 16dp 圆角会变成胶囊/椭圆开关观感。
  常态：surface_card 填充 + 1dp divider 描边；按下 / 聚焦：surface_block 填充 + 2dp primary 描边。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_block" />
            <corners android:radius="@dimen/radius_sm" />
            <stroke
                android:width="2dp"
                android:color="@color/theme_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_block" />
            <corners android:radius="@dimen/radius_sm" />
            <stroke
                android:width="2dp"
                android:color="@color/theme_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <corners android:radius="@dimen/radius_sm" />
            <stroke
                android:width="1dp"
                android:color="@color/theme_divider" />
        </shape>
    </item>
</selector>