<?xml version="1.0" encoding="utf-8"?>
<!-- 外观主题页：未选中态卡片底（surface_card，无描边；按下 / 聚焦时给 2dp primary 描边） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_block" />
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="2dp"
                android:color="@color/theme_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_block" />
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="2dp"
                android:color="@color/theme_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="2dp"
                android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>