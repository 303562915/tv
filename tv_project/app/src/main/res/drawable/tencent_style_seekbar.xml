<?xml version="1.0" encoding="utf-8"?>
<!-- 主进度条：已播 / 缓冲 / 未播 全部走 player_progress_* token -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景（未播放部分） -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/radius_xs" />
            <solid android:color="@color/player_progress_unplayed" />
        </shape>
    </item>

    <!-- 缓冲进度（已缓冲部分） -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="@dimen/radius_xs" />
                <solid android:color="@color/player_progress_buffered" />
            </shape>
        </clip>
    </item>

    <!-- 播放进度（已播放部分） -->
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/radius_xs" />
                <solid android:color="@color/player_progress_played" />
            </shape>
        </clip>
    </item>
</layer-list>
