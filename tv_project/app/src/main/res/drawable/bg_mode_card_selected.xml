<?xml version="1.0" encoding="utf-8"?>
<!-- 外观主题页：选中态卡片底（surface_card + 2dp primary 描边；聚焦时换 surface_block 填充，描边不变） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_block" />
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="2dp"
                android:color="@color/theme_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_block" />
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="2dp"
                android:color="@color/theme_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="2dp"
                android:color="@color/theme_primary" />
        </shape>
    </item>
</selector>