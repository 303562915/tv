<?xml version="1.0" encoding="utf-8"?>
<!--
  外观主题页：主题色板单项底。
  按下 / 聚焦：surface_block 填充 + 2dp primary 描边（遥控焦点可见）；
  默认：透明，只留 ripple 水波。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/theme_divider">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_block" />
                    <corners android:radius="@dimen/radius_sm" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/theme_primary" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_block" />
                    <corners android:radius="@dimen/radius_sm" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/theme_primary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="@dimen/radius_sm" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>