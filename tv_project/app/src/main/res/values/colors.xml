<?xml version="1.0" encoding="utf-8"?>
<!--
  配色取自 FlClash：prism_ui/lib/theme_data.dart 里 _baselineSeed = Color(0xFF6750A4)，
  ColorStyle.soft 对应 Material 3 tonalSpot 变体。
  下面就是这套种子在浅色下的标准 M3 结果，命名沿用本项目旧称。
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="transparent">#00000000</color>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>

    <!-- M3 主色 / 次色 -->
    <color name="primary">#FF6750A4</color>
    <color name="theme_primary">#FF6750A4</color>
    <color name="theme_accent">#FF625B71</color>
    <color name="theme_primary_container">#FFEADDFF</color>
    <color name="theme_on_primary_container">#FF21005D</color>
    <color name="theme_secondary_container">#FFE8DEF8</color>
    <color name="theme_on_secondary_container">#FF1D192B</color>

    <!-- 表面与背景 -->
    <color name="theme_background">#FFFEF7FF</color>
    <color name="theme_surface">#FFFEF7FF</color>
    <color name="theme_surface_container">#FFF3EDF7</color>
    <color name="theme_surface_container_low">#FFF7F2FA</color>
    <color name="theme_outline">#FF79747E</color>
    <color name="theme_text_primary">#FF1D1B20</color>
    <color name="theme_text_secondary">#FF49454F</color>
    <color name="theme_card">#FFECE6F0</color>
    <color name="theme_card_background">#FFF3EDF7</color>
    <color name="theme_card_elevated">#FFFFFFFF</color>
    <color name="search_box_background">#FFECE6F0</color>

    <!-- 状态色 -->
    <color name="theme_success">#FF00C853</color>
    <color name="theme_warning">#FFFFB300</color>
    <color name="theme_error">#FFBA1A1A</color>
    <color name="theme_info">#FF0288D1</color>
    <color name="theme_gradient_start">#FF6750A4</color>
    <color name="theme_gradient_end">#FF625B71</color>
    <color name="theme_selected_bg">#FFE8DEF8</color>
    <color name="theme_selected_border">#FF6750A4</color>
    <color name="theme_divider">#FFCAC4D0</color>
    <color name="theme_overlay">#80000000</color>
    <color name="theme_highlight">#FFFFF9C4</color>
    <color name="theme_disabled">#FFBDBDBD</color>

    <!-- 列表未选中态 -->
    <color name="unselected_bg">#FFF7F2FA</color>
    <color name="unselected_text">#FF49454F</color>

    <!-- 播放器进度条：主色系 -->
    <color name="player_progress_played">#FF6750A4</color>
    <color name="player_progress_buffered">#4D6750A4</color>
    <color name="player_progress_unplayed">#33FFFFFF</color>

    <!-- 选集背景（按时长区分） -->
    <color name="episode_movie_bg">#FFEADDFF</color>
    <color name="episode_normal_bg">#FFF7F2FA</color>
    <color name="episode_movie_text">#FF21005D</color>
    <color name="episode_normal_text">#FF1D1B20</color>

    <!-- ===== 悬浮胶囊底栏（FlClash NavigationDock） ===== -->
    <color name="nav_capsule">#FFF3EDF7</color>
    <color name="nav_capsule_stroke">#00FFFFFF</color>
    <color name="nav_lens">#FFE7E0EC</color>
    <color name="nav_item_idle">#FF49454F</color>
</resources>
