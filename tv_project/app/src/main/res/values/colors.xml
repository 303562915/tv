<?xml version="1.0" encoding="utf-8"?>
<!--
  配色基准：参考项目 unicanta 的 FlPalette（composeApp/.../ui/fl/FlPalette.kt），
  也就是 FlClash 那套：iOS 蓝 #007AFF 作种子、表面 chroma 压到 3 保持纸感、
  四级表面靠明度递进。浅色是"灰底 + 近白卡片"，悬浮底栏是白的。
-->
