    <string name="f050_status_idle">还没开始匹配，输入片名或点上面的演示按钮</string>
    <string name="f050_status_hit">命中 %1\$d 条 · 容错级别 %2\$d</string>
    <string name="f050_result_meta">%1\$d 分 · 距离 %2\$d</string>
    <string name="f050_result_empty">没有命中</string>
