<resources>
    <string name="f035_title">M3U 播放列表导入导出</string>
    <string name="f035_desc">按标准 M3U/M3U8 文本与其他播放器交换队列：导出展示生成的全文，导入解析 EXTINF 标题与时长，非法行只统计不报错</string>

    <!-- 导出 -->
    <string name="f035_section_export">导出</string>
    <string name="f035_export_hint">下面是把内置 4 条示例队列交给导出器得到的原文：第一行 #EXTM3U 是文件头，之后每条两行 —— #EXTINF:时长(秒),标题 与地址；时长 -1 表示直播或未知长度。</string>
    <string name="f035_export_action">重新生成导出文本</string>
    <string name="f035_copy_action">复制到剪贴板</string>
    <string name="f035_export_stat">示例 %1$d 条 · 生成 %2$d 行文本</string>

    <string name="f035_sample_1_title">体育频道 · 直播</string>
    <string name="f035_sample_2_title">示例电影 · 正片</string>
    <string name="f035_sample_3_title">赛事直播 · 推流地址</string>
    <string name="f035_sample_4_title">本地片源 · 离线比赛录像</string>

    <!-- 导入 -->
    <string name="f035_section_import">导入</string>
    <string name="f035_import_hint">把外部 M3U 文本粘进输入框再解析。电视上用遥控器敲字麻烦，建议在手机上复制内容后按「读取剪贴板」直接灌进来；解析只读内存，不落盘、不联网。</string>
    <string name="f035_input_hint">在此粘贴 M3U / M3U8 文本…</string>
