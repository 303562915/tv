<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Day Mode -->
    <style name="Theme.影视星球" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/theme_primary</item>
        <item name="colorPrimaryVariant">@color/theme_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/theme_accent</item>
        <item name="colorSecondaryVariant">@color/theme_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background colors -->
        <item name="android:colorBackground">@color/theme_background</item>
        <item name="colorSurface">@color/theme_card_background</item>
        <item name="colorOnSurface">@color/theme_text_primary</item>
        <!-- Status bar color - 透明 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">true</item>
        <!-- Font family -->
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="fontFamily">@font/custom_font</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/theme_text_primary</item>
        <item name="android:textColorSecondary">@color/theme_text_secondary</item>
    </style>

    <!-- Dialog slide animation -->
    <style name="DialogSlideAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- Transparent Dialog -->
    <style name="TransparentDialog" parent="android:Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- Tab Text Appearance - 放大文字 -->
    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/theme_text_primary</item>
    </style>

    <!-- Tab Text Appearance - 小号文字 -->
    <style name="TabTextSmall" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/theme_text_secondary</item>
    </style>

    <!-- ================= 底栏（Material 3 NavigationBar，参考 FlClash 风格） ================= -->
    <!-- 选中指示器：全圆角胶囊 -->
    <style name="Widget.TVPlayer.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bottom_nav_indicator</item>
        <item name="android:width">56dp</item>
        <item name="android:height">30dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TVPlayer.Pill</item>
    </style>

    <style name="ShapeAppearance.TVPlayer.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 底栏主体：紧凑、无涟漪、surface 背景 -->
    <style name="Widget.TVPlayer.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.TVPlayer.BottomNav.ActiveIndicator</item>
        <item name="itemIconTint">@color/bottom_nav_tint</item>
        <item name="itemTextColor">@color/bottom_nav_tint</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.TVPlayer.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.TVPlayer.BottomNav</item>
        <item name="itemRippleColor">@null</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:minHeight">64dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TextAppearance.TVPlayer.BottomNav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.TVPlayer.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Full Width Bottom Sheet Dialog -->
    <style name="FullWidthBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/FullWidthBottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:colorBackground">@color/theme_card_background</item>
    </style>

    <style name="FullWidthBottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@color/theme_card_background</item>
    </style>
</resources>