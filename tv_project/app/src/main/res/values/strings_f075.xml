<?xml version="1.0" encoding="utf-8"?>
<!-- 功能 F075「CSV 数据导出」自身文案（功能中心外壳文案在 strings_feature_center.xml） -->
<resources>
    <string name="f075_title">CSV 数据导出</string>
    <string name="f075_desc">把观看历史和收藏导成 CSV，用表格软件打开就能按时间、进度排序翻看</string>

    <!-- 导出卡片 -->
    <string name="f075_section_export">导出</string>
    <string name="f075_action_back">返回</string>
    <string name="f075_action_history">导出历史</string>
    <string name="f075_action_history_hint">标题,播放时间,进度秒,时长秒</string>
    <string name="f075_action_favorites">导出收藏</string>
    <string name="f075_action_favorites_hint">标题,封面,收藏时间,标签</string>
    <string name="f075_kind_history">观看历史</string>
    <string name="f075_kind_favorites">收藏</string>

    <!-- 状态行 -->
    <string name="f075_status_idle">点「导出历史」或「导出收藏」，CSV 会写进下载目录；下面先看一遍将写出的前 10 行</string>
    <string name="f075_status_busy">正在生成%1$s的 CSV…</string>
    <string name="f075_status_written">已写入%1$s CSV，共 %2$s</string>
    <string name="f075_status_failed">导出失败：%1$s</string>

    <!-- 预览卡片 -->
    <string name="f075_section_preview">CSV 预览</string>
    <string name="f075_preview_hint">还没导出。点上面的按钮后，这里显示将写出的 CSV 前 10 行（含表头），逗号与引号按 RFC 4180 转义后的样子原样呈现。</string>
    <string name="f075_preview_note_idle">预览最多 10 行，字段里带逗号 / 引号的会整体加双引号</string>
    <string name="f075_preview_note">共 %1$d 行记录（含表头），这里只预览前 %2$d 行</string>

    <!-- 写入结果卡片 -->
    <string name="f075_section_result">写入结果</string>
    <string name="f075_result_path_label">文件路径</string>
    <string name="f075_result_path_empty">尚未写出文件</string>
    <string name="f075_result_bytes_label">文件大小</string>
    <string name="f075_result_bytes">%1$d 字节（%2$s）</string>
    <string name="f075_result_bytes_empty">—</string>
    <string name="f075_result_fallback">公共下载目录不可写，已回落到应用专属外部目录：换机或卸载后会一起清掉，需要的话从上面的路径拷走</string>

    <!-- 转义示例卡片 -->
    <string name="f075_section_sample">转义示例</string>
    <string name="f075_sample_raw">蓝色星球 II, \"第 1 集\"</string>
    <string name="f075_sample_body">原始标题：%1$s\n写进 CSV：%2$s</string>
    <string name="f075_sample_hint">规则：字段里出现逗号、双引号、换行时整体加双引号，引号本身写成两个；记录之间用 CRLF 分隔，文件开头带 UTF-8 BOM，Excel 直接双击打开中文不乱码</string>

    <!-- Toast -->
    <string name="f075_toast_busy">上一份还没写完，稍等一下</string>
    <string name="f075_toast_written">导出完成，路径见下方「写入结果」</string>
    <string name="f075_toast_failed">导出没成功，原因见状态行</string>

    <string name="f075_engine_note">接线：F075Engine.toCsv(rows) 出 RFC 4180 文本，historyCsv(items) / favoritesCsv(items) 各出带表头的一张，writeCsv(context, fileName, csv) 先试公共下载目录、再试 getExternalFilesDir、最后退到 filesDir/csv_export；引擎不读数据源，本版页面用的是 sampleHistory() / sampleFavorites()。</string>
</resources>