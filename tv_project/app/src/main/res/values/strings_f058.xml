    <string name="f058_title">流量统计</string>
    <string name="f058_desc">播放器每解码一段就报一次字节数，这里把本次会话、今日、近七天按日期分桶记下来，想清就清，超量一眼能看出来</string>

    <string name="f058_report_section">模拟上报</string>
    <string name="f058_add_small">+1 MB</string>
    <string name="f058_add_large">+50 MB</string>
