<?xml version="1.0" encoding="utf-8"?>
<!-- 功能 F065「局域网目录浏览」自身文案（功能中心外壳文案在 strings_feature_center.xml） -->
<resources>
    <string name="f065_title">局域网目录浏览</string>
    <string name="f065_desc">把电视上的目录挂成网页，手机或电脑在同一局域网里点开就能浏览、下载；只读，数据不出局域网</string>

    <!-- 服务 -->
    <string name="f065_section_server">服务</string>
    <string name="f065_port_label">端口</string>
    <string name="f065_port_hint">1024–65535，默认 8090</string>
    <string name="f065_action_start">启动服务</string>
    <string name="f065_action_restart">重新启动</string>
    <string name="f065_action_stop">停止</string>
    <string name="f065_action_hint">确认键</string>
    <string name="f065_action_back">返回</string>

    <!-- 状态行 -->
    <string name="f065_state_idle">还没启动。选好端口后点「启动服务」，再把下面的地址敲到手机浏览器里</string>
    <string name="f065_state_not_running">未运行</string>
    <string name="f065_state_running">运行中</string>
    <string name="f065_state_starting">正在启动…</string>
    <string name="f065_state_stopped">已停止</string>
    <string name="f065_state_listening">地址已就绪，局域网内的设备可以直接打开</string>
    <string name="f065_state_failed">启动失败：%1$s</string>
    <string name="f065_status_line">服务状态：%1$s · %2$s</string>

    <!-- 访问地址 -->
    <string name="f065_address_label">访问地址</string>
    <string name="f065_address_empty">—</string>
    <string name="f065_hint_lan">在同一局域网里的手机 / 电脑浏览器中打开上面的地址，就能看到目录页</string>
    <string name="f065_hint_no_lan">没取到局域网地址：先确认电视已连上 Wi-Fi 或网线，再重新启动服务</string>
    <string name="f065_hint_port_shifted">端口 %1$d 被占用，已改用 %2$d</string>

    <!-- 浏览目录 -->
    <string name="f065_section_root">浏览目录</string>
    <string name="f065_root_label">根目录</string>
    <string name="f065_root_hint">这个目录是应用自己的外部目录，不需要任何存储权限。把要分享的照片、视频、文档拷进来，再在浏览器里刷新页面即可看到；卸载应用时会被一起清掉，所以别把它当长期仓库。</string>

    <!-- 最近访问 -->
    <string name="f065_section_log">最近访问</string>
    <string name="f065_log_clear">清空</string>
    <string name="f065_log_empty">还没有访问记录。用手机打开上面的地址后，这里会显示对方的 IP、请求的路径和返回的状态码。</string>
    <string name="f065_log_line">%1$s · %2$s</string>
    <string name="f065_log_access">%1$s 请求 %2$s → %3$d</string>
    <string name="f065_log_started">服务已启动，端口 %1$d</string>
    <string name="f065_log_stopped">服务已停止</string>
    <string name="f065_log_start_failed">启动失败：%1$s</string>

    <!-- 提示 -->
    <string name="f065_err_port">端口要填 1024–65535 之间的数字</string>
    <string name="f065_err_root">浏览目录不可用</string>
    <string name="f065_toast_started">已启动：%1$s</string>
    <string name="f065_toast_start_failed">启动失败，原因见状态行</string>

    <string name="f065_engine_note">接线：F065Activity 调 F065Engine.start(port, rootDir) 起只读 HTTP 服务（NanoHTTPD 2.3.1，包名 fi.iki.elonen），拿到 StartResult(address, port, error) 后显示访问地址；引擎自己按 GET / HEAD 处理请求，目录走 HTML 列表（名字转义、目录在前、带大小），文件支持 Range 从而回 206，每个请求通过回调上报 F065Access(ip, method, path, status) 供「最近访问」展示；端口被占会顺延，最多试 5 个。</string>
</resources>
