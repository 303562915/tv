    <string name="f055_label_doh_url">DoH 端点地址</string>
    <string name="f055_hint_doh_url">https://dns.alidns.com/resolve</string>
    <string name="f055_label_switch">启用 DoH</string>
    <string name="f055_hint_switch">关闭时解析一律走系统 DNS</string>
    <string name="f055_hint_preset">点预设可一键填入端点；地址改完离开输入框即保存</string>
    <string name="f055_status_on">已启用：解析优先走 %1$s</string>
    <string name="f055_status_off">未启用：解析走系统 DNS，端点仅作备用</string>
    <string name="f055_switch_on">已启用 DoH</string>
