    <string name="f055_action_hint">确认键</string>
    <string name="f055_action_back">返回</string>
    <string name="f055_host_empty">先填一个要解析的域名</string>
    <string name="f055_resolving_doh">正在用 DoH 解析 %1$s…</string>
    <string name="f055_resolving_system">DoH 未启用，正在走系统 DNS 解析 %1$s…</string>
    <string name="f055_probing">正在测试端点连通性…</string>
    <string name="f055_probe_ok">端点可用，返回 %1$d 字节</string>
