<?xml version="1.0" encoding="utf-8"?>
<!-- 功能 F014「同名字幕自动匹配」自身文案（功能中心外壳文案在 strings_feature_center.xml）；键名一律 f014_ 前缀 -->
<resources>
    <string name="f014_title">同名字幕自动匹配</string>
    <string name="f014_desc">视频旁边放着的同名字幕会被自动认出来，按语言优先级挑一条</string>

    <!-- 模拟目录 -->
    <string name="f014_section_input">模拟目录</string>
    <string name="f014_video_label">视频文件</string>
    <string name="f014_video_hint">填视频文件名，例如 movie.mp4；带目录也行，例如 Movies/movie.mp4</string>
    <string name="f014_file_label">目录里的文件（可增删）</string>
    <string name="f014_file_input_hint">例如 movie.zh.srt</string>
    <string name="f014_add">加入</string>
    <string name="f014_match">匹配</string>
    <string name="f014_reset">恢复示例</string>
    <string name="f014_file_hint">点列表里的一行即可移除；字幕只认 srt / ass / ssa / vtt</string>
    <string name="f014_file_empty">目录还是空的，先在上面加几个文件</string>
    <string name="f014_file_remove">移除</string>
    <string name="f014_file_row_desc">%1$s，确认键移除</string>

    <!-- 匹配结果 -->
    <string name="f014_section_result">匹配结果</string>
    <string name="f014_result_language_value">语言 %1$s</string>
    <string name="f014_confidence_value">置信度 %1$d%%</string>
    <string name="f014_language_untagged">未标注（完全同名）</string>
    <string name="f014_language_tagged">%1$s（%2$s）</string>
    <string name="f014_empty_idle">还没有匹配过</string>
    <string name="f014_empty_no_match">没有和 %1$s 同名的字幕：按规则静默跳过，不加载也不报错</string>
    <string name="f014_empty_video_blank">先填一个视频文件名再匹配</string>

    <!-- 候选排序 -->
    <string name="f014_section_candidates">候选排序</string>
    <string name="f014_candidate_header">序号 / 文件 / 语言 · 置信度</string>
    <string name="f014_candidate_empty">没有候选</string>
    <string name="f014_candidate_rank">#%1$d</string>
    <string name="f014_candidate_detail">%1$s · %2$d%%</string>
    <string name="f014_candidate_selected">选中 · %1$s</string>

    <!-- 提示 -->
    <string name="f014_added">已加入 %1$s</string>
    <string name="f014_added_duplicate">%1$s 已经在列表里了</string>
    <string name="f014_removed">已移除 %1$s</string>
    <string name="f014_input_blank">文件名不能为空</string>
    <string name="f014_rule_note">规则：字幕要和视频在同一目录（或同级的 Subs / Subtitles / SUB / 字幕 子目录）；字幕主干名剥掉尾部语言标记和 (1) 这类拷贝序号后，必须与视频名一致 —— movie.mp4 能命中 movie.srt、movie.zh.srt、movie.chs.srt、movie(1).srt。多个候选按「完全同名 &gt; zh-Hans &gt; zh-Hant &gt; en &gt; 其它」排序取第一；一个都对不上就返回 null，播放时静默跳过。</string>
</resources>
