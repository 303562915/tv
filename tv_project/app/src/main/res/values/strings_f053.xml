<resources>
    <string name="f053_title">网络诊断面板</string>
    <string name="f053_desc">播放卡顿时先测 DNS 解析耗时，再测目标端口能不能连上，最后给一条结论：是解析慢、连不上，还是网络其实没问题</string>

    <string name="f053_target_section">探测目标</string>
    <string name="f053_host_hint">域名或 IP，例如 8.8.8.8</string>
    <string name="f053_port_hint">端口，例如 443</string>
    <string name="f053_diagnose">开始诊断</string>
    <string name="f053_diagnosing">正在诊断…</string>

    <string name="f053_status_ready">还没开始 · 默认探测 8.8.8.8:443，Host 与端口都可以改</string>
    <string name="f053_status_running">正在诊断 %1$s:%2$d · DNS 解析与 TCP 连接各跑一次</string>
    <string name="f053_status_done">上一次诊断 %1$s:%2$d · 完成于 %3$s</string>
    <string name="f053_status_busy">上一次还在跑，等它出结果</string>

    <string name="f053_result_section">诊断结果</string>

    <string name="f053_dns_idle">DNS 解析 · 未测</string>
    <string name="f053_dns_idle_detail">解析耗时与解析到的地址会显示在这里</string>
    <string name="f053_dns_value">DNS 解析 %1$s</string>
    <string name="f053_dns_fail_value">DNS 解析失败 %1$s</string>
