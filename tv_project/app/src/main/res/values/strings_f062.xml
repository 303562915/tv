<resources>
    <string name="f062_title">投屏会话控制</string>
    <string name="f062_desc">投上大屏只是开始：播放、暂停、进度、音量都直接发给设备的 AVTransport，回执原文留在最下面可展开</string>

    <!-- 会话卡片 -->
    <string name="f062_section_session">当前会话</string>
    <string name="f062_label_control_url">AVTransport 控制地址</string>
    <string name="f062_hint_control_url">http://192.168.1.10:49152/AVTransport/control</string>
    <string name="f062_label_device">设备名</string>
    <string name="f062_hint_device">客厅电视</string>
    <string name="f062_label_state">播放态</string>
    <string name="f062_label_volume">音量</string>
    <string name="f062_label_reltime">进度</string>
    <string name="f062_state_idle">空闲</string>
    <string name="f062_state_playing">播放中</string>
    <string name="f062_state_paused">已暂停</string>
    <string name="f062_volume_value">%1$d / 100</string>
    <string name="f062_value_none">—</string>
    <string name="f062_session_value">%1$s · %2$s</string>
    <string name="f062_status_idle">填好控制地址后点上面的按钮，会话会按设备回执建立；地址变了会自动重开会话</string>
    <string name="f062_status_ok">成功 · %1$s</string>

    <!-- 控制卡片 -->
    <string name="f062_section_control">播放控制</string>
    <string name="f062_action_play">播放</string>
    <string name="f062_action_restart">从头播</string>
    <string name="f062_action_pause">暂停</string>
    <string name="f062_action_stop">停止</string>
    <string name="f062_action_hint">确认键</string>
    <string name="f062_action_back">返回</string>
    <string name="f062_label_seek">跳转到</string>
    <string name="f062_hint_seek">00:01:30</string>
    <string name="f062_action_seek">跳转</string>
    <string name="f062_label_volume_set">音量设置</string>
    <string name="f062_hint_volume">0 ~ 100</string>
    <string name="f062_action_volume_down">－</string>
    <string name="f062_action_volume_set">设置</string>
    <string name="f062_action_volume_up">＋</string>
    <string name="f062_action_refresh">刷新设备状态</string>

    <!-- 回执卡片 -->
    <string name="f062_section_response">最近一次 SOAP 响应</string>
    <string name="f062_response_title">展开回执原文</string>
    <string name="f062_response_hint">成功不一定只是 HTTP 200：设备也可能带着 200 回一个 UPnP 错误码，这里能看到原始报文</string>
    <string name="f062_response_empty">还没有发过请求</string>
    <string name="f062_arrow_collapsed">▸</string>
    <string name="f062_arrow_expanded">▾</string>
    <string name="f062_response_show">展开回执原文</string>
    <string name="f062_response_hide">收起回执原文</string>

    <!-- 提示 -->
    <string name="f062_err_no_url">先填设备的控制地址</string>
    <string name="f062_err_seek_empty">先填要跳转到的位置</string>
    <string name="f062_err_seek_invalid">位置格式不对，按 00:01:30 或 01:30 填</string>
    <string name="f062_err_volume_invalid">音量只能是 0 ~ 100 的整数</string>
    <string name="f062_toast_volume_limit">音量已经到头：%1$d</string>
    <string name="f062_toast_ok">已下发 %1$s</string>
    <string name="f062_toast_fail">设备没接受：%1$s</string>

    <string name="f062_engine_note">接线：所有动作都走 F062Engine（阻塞，放 Dispatchers.IO）。Play / Restart / Pause / Stop / Seek 打 AVTransport，音量打同一台设备的 RenderingControl（地址由 /AVTransport/control 换成 /RenderingControl/control，见 endpointFor）。Restart = Seek(REL_TIME, 00:00:00) + Play，Seek 失败但 Play 成功算部分成功，只用 note 提示。返回的 Outcome.session 是新的会话快照，界面直接覆盖本地状态即可，不要自己推状态。</string>
</resources>
