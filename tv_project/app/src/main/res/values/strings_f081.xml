<?xml version="1.0" encoding="utf-8"?>
<!-- 功能 F081「播放默认值中心」自身文案（功能中心外壳文案在 strings_feature_center.xml） -->
<resources>
    <string name="f081_title">播放默认值中心</string>
    <string name="f081_desc">倍速 / 比例 / 自动连播 / 快进步长 / 长按倍速 / 字幕自动加载一次配好，只影响此后的新播放</string>

    <!-- 六项默认值卡片 -->
    <string name="f081_section_defaults">默认播放行为</string>
    <string name="f081_defaults_hint">下面六项决定每一次新起播的初始状态；改完记得点最下方的「保存默认值」</string>
    <string name="f081_label_speed">默认倍速</string>
    <string name="f081_hint_speed">起播就用这个倍速，可选择 0.5x ~ 3.0x</string>
    <string name="f081_label_aspect">默认画面比例</string>
    <string name="f081_hint_aspect">适应屏幕留黑边不裁画面，裁切填满会切掉边缘，拉伸铺满会变形</string>
    <string name="f081_label_auto_next">自动连播</string>
    <string name="f081_hint_auto_next">一集播完自动接下一集，关闭后停在片尾</string>
    <string name="f081_label_seek_step">快进步长</string>
    <string name="f081_hint_seek_step">按一次快进 / 快退前进多少秒，可选 5 ~ 120 秒</string>
    <string name="f081_label_long_press">长按倍速</string>
    <string name="f081_hint_long_press">长按快进方向键时按这个倍数播放，松手恢复原倍速</string>
    <string name="f081_label_subtitle">字幕自动加载</string>
    <string name="f081_hint_subtitle">起播后自动加载同名 / 同目录的字幕文件</string>
    <string name="f081_switch_auto_next">自动连播开关</string>
    <string name="f081_switch_subtitle">字幕自动加载开关</string>

    <!-- 当前生效配置卡片 -->
    <string name="f081_section_summary">当前生效配置</string>
    <string name="f081_summary_default">出厂默认组合</string>
    <string name="f081_summary_custom">自定义组合</string>
    <string name="f081_scope_note">只影响此后的新播放：正在播的这一集保持起播时的设置，保存后新发起的播放才按这份配置开始。</string>

    <!-- 动作卡片 -->
    <string name="f081_section_action">保存</string>
    <string name="f081_action_save">保存默认值</string>
    <string name="f081_action_save_hint">对新播放生效</string>
    <string name="f081_action_reset">恢复默认</string>
    <string name="f081_action_reset_hint">一键回六项出厂值</string>
    <string name="f081_action_back">返回</string>

    <!-- 状态行 -->
    <string name="f081_status_loaded">已载入当前默认值。面板上的改动要点「保存默认值」才生效，只影响此后的新播放。</string>
    <string name="f081_status_dirty">面板已改，还没保存——正在播的这一集不受影响，保存后新发起的播放才用新值。</string>
    <string name="f081_status_saved">已保存。下一次发起播放就按「当前生效配置」里的这份快照开始。</string>
    <string name="f081_status_reset">已恢复默认并保存，六项都回到出厂组合，下一次发起播放按默认值开始。</string>
    <string name="f081_status_error">保存失败：%1$s</string>

    <!-- Toast -->
    <string name="f081_toast_saved">已保存，对新播放生效</string>
    <string name="f081_toast_reset">已恢复默认</string>

    <string name="f081_engine_note">接线：F081Engine.defaults() 给出厂组合，load(context) 读盘并夹进合法区间，save(context, d) 校验 + 落盘 + 发布快照（返回真正写下的那份），applyTo(d) 不落盘、只把一份配置发布成"下一次起播读到的快照"并返回它；播放页起播时读 F081Engine.current() 或直接用 applyTo 的返回值即可，正在播放的那一集握着旧快照不受影响。</string>
</resources>
