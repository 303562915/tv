<?xml version="1.0" encoding="utf-8"?>
<!--
  「备份恢复与校验」页 · 与功能中心其它页同一套卡片语言：
  MaterialCardView + 圆角卡片，卡片内部只有 Caption / Body 两级文字，
  焦点态沿用 bg_card_surface + 2dp primary 描边，不额外加色块。
  电视没有触摸屏：每个可操作控件都 focusable，nextFocus* 串成
  返回 → 选择备份 zip → 试运行 → 恢复。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <TextView
            android:id="@+id/f072BackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/list_row_min_height"
            android:nextFocusDown="@id/f072PickButton"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding"
            android:text="@string/f072_back"
            android:textAppearance="@style/TextAppearance.TVPlayer.Body"
            android:textColor="@color/theme_text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:text="@string/f072_title"
            android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f072_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 小节：备份来源 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f072_section_source"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <Button
                    android:id="@+id/f072PickButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_primary"
                    android:focusable="true"
                    android:minHeight="@dimen/list_row_min_height"
                    android:nextFocusDown="@id/f072DryRunButton"
                    android:nextFocusUp="@id/f072BackButton"
                    android:text="@string/f072_action_pick" />

                <TextView
                    android:id="@+id/f072FileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/f072_file_empty"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                <TextView
                    android:id="@+id/f072StatusValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/f072_status_idle"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                    android:textColor="@color/theme_text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/f072_pick_hint"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：清单 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f072_section_manifest"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="96dp"
                        android:text="@string/f072_label_version"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <TextView
                        android:id="@+id/f072VersionValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f072_value_unknown"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="96dp"
                        android:text="@string/f072_label_created"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <TextView
                        android:id="@+id/f072CreatedValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f072_value_unknown"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="96dp"
                        android:text="@string/f072_label_entries"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <TextView
                        android:id="@+id/f072EntriesValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f072_value_unknown"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="96dp"
                        android:text="@string/f072_label_checksum"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <TextView
                        android:id="@+id/f072ChecksumValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f072_value_unknown"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="96dp"
                        android:text="@string/f072_label_compat"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <TextView
                        android:id="@+id/f072CompatValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f072_value_unknown"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_text_secondary" />
                </LinearLayout>

                <!-- 逐条校验结果，由 Activity 按清单动态填充 -->
                <LinearLayout
                    android:id="@+id/f072EntriesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：校验问题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f072_section_problems"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/f072ProblemsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f072_problems_empty"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <LinearLayout
                    android:id="@+id/f072ProblemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：恢复 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f072_section_restore"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="96dp"
                        android:text="@string/f072_label_target"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <TextView
                        android:id="@+id/f072TargetValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_text_primary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/f072_restore_hint"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/f072DryRunButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:focusable="true"
                        android:minHeight="@dimen/list_row_min_height"
                        android:nextFocusDown="@id/f072RestoreButton"
                        android:nextFocusUp="@id/f072PickButton"
                        android:text="@string/f072_action_dry_run" />

                    <Button
                        android:id="@+id/f072RestoreButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:focusable="true"
                        android:minHeight="@dimen/list_row_min_height"
                        android:nextFocusUp="@id/f072DryRunButton"
                        android:text="@string/f072_action_restore" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：结果 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f072_section_result"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/f072ResultValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f072_result_idle"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                    android:textColor="@color/theme_text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="96dp"
                        android:text="@string/f072_label_rollback"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <TextView
                        android:id="@+id/f072RollbackValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f072_rollback_none"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                </LinearLayout>

                <!-- 恢复过程的补充问题（不会重复上方的校验问题） -->
                <LinearLayout
                    android:id="@+id/f072ResultProblems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
