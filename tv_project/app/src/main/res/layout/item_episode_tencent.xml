<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/episodeCard"
    style="@style/Widget.TVPlayer.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:minHeight="60dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_block"
    app:cardCornerRadius="@dimen/radius_sm"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">

        <!--
            VIP 角标：**永不显示**（本仓库选集格子没有任何 VIP 判定逻辑）。
            视图保留只为不让 ViewBinding 缺字段（EpisodeSelectorAdapter 仍会引用 vipBadge 并强制 GONE），
            真机上一律 gone；tools:visibility 只是让 IDE 预览也按 gone 画，避免误以为它还会出现。
        -->
        <TextView
            android:id="@+id/vipBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIP"
            android:textColor="@color/theme_text_secondary"
            android:textSize="7sp"
            android:textStyle="bold"
            android:background="@drawable/vip_badge_bg"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginTop="1dp"
            android:visibility="gone"
            tools:visibility="gone" />

        <!-- 集数 -->
        <TextView
            android:id="@+id/episodeNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="28dp"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/theme_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="13sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:maxLines="1" />

        <!-- 集名称 -->
        <TextView
            android:id="@+id/episodeNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="第1集"
            android:textColor="@color/theme_text_secondary"
            android:textSize="8sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeStepGranularity="1sp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>