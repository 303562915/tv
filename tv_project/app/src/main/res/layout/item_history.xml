<?xml version="1.0" encoding="utf-8"?>
<!--
  历史卡片：封面 96×128（3:4）+ 右侧信息列，右侧高度锁死等于封面高度，
  信息用顶部标题 / 中部弹性 / 底部进度三段撑满，不再出现「上面两行字、下面大片空白」。
  旧版封面 120×160、卡片圆角 24dp、右侧只有两行文字且顶部对齐，卡片整体又高又空。

  外层换成 SwipeRevealLayout：第一个孩子是右侧 64dp 删除区（先写，画在底层），
  第二个孩子是卡片（后写，画在顶层）。左滑把卡片平移出去，删除区才露出来；
  点击删除区触发删除，点卡片本身才是「继续播放」。
-->
<com.tv.ball.widget.SwipeRevealLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap">

    <!-- 删除区：藏在卡片下面，卡片左滑 96dp 后才露出来；背景用和卡片同圆角的红块 -->
    <LinearLayout
        android:id="@+id/btnSwipeDelete"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_swipe_action"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_delete"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="删除"
            android:textColor="@color/white"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.TVPlayer.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="@dimen/radius_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- 封面：自身一张圆角卡，图裁剪在圆角内 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="96dp"
                android:layout_height="128dp"
                app:cardBackgroundColor="@color/surface_block"
                app:cardCornerRadius="@dimen/radius_sm"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/videoCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface_block"
                    android:contentDescription="视频封面"
                    android:scaleType="centerCrop" />

                <!-- 集数角标：清洗掉线路名后只剩「第1集」，没有就不显示 -->
                <TextView
                    android:id="@+id/videoEpisode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_episode_badge"
                    android:ellipsize="end"
                    android:maxWidth="88dp"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    tools:text="第1集" />

                <!-- 多选勾选标记：默认隐藏，选中时才出现；只出主色，不给整张卡片铺底色 -->
                <ImageView
                    android:id="@+id/selectionMark"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_episode_badge"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    android:src="@drawable/ic_check_primary"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/videoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="我和妈妈的长征" />

                <TextView
                    android:id="@+id/videoMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="@dimen/text_caption"
                    tools:text="第1集 · 今天 21:06" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:max="100"
                    android:progressBackgroundTint="@color/surface_inset"
                    android:progressTint="@color/theme_primary"
                    tools:progress="41" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/theme_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="41%" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="@dimen/text_caption"
                        tools:text="剩余 27:13" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</com.tv.ball.widget.SwipeRevealLayout>
