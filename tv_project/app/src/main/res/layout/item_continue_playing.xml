<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/page_margin"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    android:minHeight="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <!-- 封面图 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="160dp"
            app:cardBackgroundColor="@color/surface_block"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_launcher_background"
                android:contentDescription="视频封面" />

            <!-- 播放图标覆盖层 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/theme_overlay" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:alpha="0.9"
                android:src="@drawable/ic_play"
                app:tint="@color/white"
                android:importantForAccessibility="no" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 视频信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/card_padding"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- 标题 -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/theme_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="电影标题" />

            <!-- 集数信息 -->
            <TextView
                android:id="@+id/tvEpisode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/theme_text_secondary"
                android:textSize="@dimen/text_caption"
                tools:text="第1集" />

            <!-- 进度信息 -->
            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:textColor="@color/theme_text_secondary"
                android:textSize="@dimen/text_caption"
                tools:text="已观看 15:30 / 45:00" />

            <!-- 进度条 -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="@dimen/card_gap"
                android:progressBackgroundTint="@color/surface_inset"
                android:progressTint="?attr/colorPrimary"
                tools:progress="30" />

            <!-- 继续播放按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:text="@string/history_continue"
                android:textSize="@dimen/text_body"
                app:cornerRadius="@dimen/radius_full"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconSize="18dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
