<?xml version="1.0" encoding="utf-8"?>
<!-- 选集格子：未选中 block 底；当前集由代码改实心 primary；圆角 8dp -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    style="@style/Widget.TVPlayer.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/surface_block"
    app:cardCornerRadius="@dimen/radius_sm"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvEpisode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/episode_text_color"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="1集" />

        <!-- 「上次看到这一集」的小角标：只有带历史记录的那一格显示，显隐由 GroupedEpisodeAdapter 控制 -->
        <TextView
            android:id="@+id/lastWatchedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="5dp"
            android:text="●"
            android:textSize="9sp"
            android:textColor="@color/theme_primary"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>