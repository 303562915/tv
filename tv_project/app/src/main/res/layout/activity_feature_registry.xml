<?xml version="1.0" encoding="utf-8"?>
<!--
  功能中心入口页。
  外壳自己画（标题 + 说明 + 列表），每个功能的菜单行由 FeatureRegistryAdapter 生成，
  样式复用「我的」页的卡片 / 列表行 / 分隔线 token，保证与全站一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="4dp"
        android:text="@string/feature_lab"
        android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/card_gap"
        android:text="@string/feature_lab_desc"
        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

    <TextView
        android:id="@+id/emptyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/page_margin"
        android:text="@string/feature_lab_empty"
        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
        android:textColor="@color/theme_text_secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/featureList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
