<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 播放器视图 -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="never"
        app:use_controller="false" />

    <!-- 字幕视图 -->
    <com.google.android.exoplayer2.ui.SubtitleView
        android:id="@+id/subtitleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom" />

    <!-- 加载提示 -->
    <LinearLayout
        android:id="@+id/loadingView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="正在缓冲"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_body" />
        
        <TextView
            android:id="@+id/bandwidthText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 手势反馈提示 -->
    <LinearLayout
        android:id="@+id/gestureHintLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/gesture_hint_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/gestureHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 错误提示 -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_title"
        android:visibility="gone" />
    
    <!-- 网速质量提示 -->
    <TextView
        android:id="@+id/qualityHintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@drawable/gesture_hint_background"
        android:padding="12dp"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />
    
    <!-- 跳过片头按钮 -->
    <Button
        android:id="@+id/skipIntroButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/gesture_hint_background"
        android:text="跳过片头 ⏭"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_body"
        android:padding="12dp"
        android:visibility="gone" />

    <!-- 顶部工具栏 -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_top"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 状态栏：时间、网络、电量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/currentTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />
            
            <!-- 网速显示 -->
            <TextView
                android:id="@+id/networkSpeedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption"
                android:text="0 KB/s" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/networkStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/batteryIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:src="@android:drawable/ic_lock_idle_charging"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:padding="6dp"
                android:src="@drawable/dkplayer_ic_action_arrow_back"
                android:scaleType="centerInside"
                android:tint="@android:color/white" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_title" />

            <ImageButton
                android:id="@+id/shareButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="分享"
                android:padding="10dp"
                android:src="@drawable/share"
                android:scaleType="fitCenter"
                android:tint="@android:color/white"
                android:visibility="visible" />

            <ImageButton
                android:id="@+id/castButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="投屏"
                android:padding="10dp"
                android:src="@drawable/fit_to_screen"
                android:scaleType="fitCenter"
                android:tint="@android:color/white"
                android:visibility="visible" />

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="菜单"
                android:padding="10dp"
                android:src="@drawable/dots_vertical"
                android:scaleType="fitCenter"
                android:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- 左侧控制栏 -->
    <LinearLayout
        android:id="@+id/leftControlBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="18dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/lockButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/gesture_hint_background"
            android:contentDescription="锁定"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/closure_unlock_btn"
            android:tint="@android:color/white" />
    </LinearLayout>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 丢帧信息 -->
        <TextView
            android:id="@+id/droppedFramesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <!-- 进度条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/currentPositionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">

                <!-- 播放进度条 -->
                <SeekBar
                    android:id="@+id/progressSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:progressDrawable="@android:drawable/progress_horizontal"
                    android:progressTint="@color/player_progress_played"
                    android:secondaryProgressTint="@color/player_progress_buffered"
                    android:thumbTint="@color/player_progress_played"
                    android:thumbOffset="0dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/durationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- 控制按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="播放/暂停"
                android:padding="8dp"
                android:src="@drawable/dkplayer_ic_action_pause"
                android:scaleType="fitCenter"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="下一集"
                android:padding="8dp"
                android:src="@drawable/album_play_next"
                android:scaleType="fitCenter"
                android:tint="@android:color/white"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/screenshotButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="截屏"
                android:padding="8dp"
                android:src="@drawable/dkplayer_ic_action_close"
                android:scaleType="fitCenter"
                android:tint="@android:color/white"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/qualityButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="清晰"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption" />

            <Button
                android:id="@+id/episodeButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="选集"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption" />

            <Button
                android:id="@+id/speedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="倍速"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption" />

            <ImageButton
                android:id="@+id/rotateButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="旋转"
                android:padding="8dp"
                android:src="@drawable/fit_to_screen"
                android:scaleType="fitCenter"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/fullscreenButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="全屏"
                android:padding="8dp"
                android:src="@drawable/dkplayer_ic_action_fullscreen1"
                android:scaleType="fitCenter"
                android:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
