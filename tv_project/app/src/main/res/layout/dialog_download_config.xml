<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#424242"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下载文件"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingBottom="16dp" />

        <!-- 链接显示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="链接: 复制"
                android:textSize="14sp"
                android:textColor="#E0E0E0" />

            <TextView
                android:id="@+id/btnCopyUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="复制"
                android:textSize="14sp"
                android:textColor="#FF9800"
                android:padding="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://example.com/video.m3u8"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:background="#616161"
            android:layout_marginTop="8dp"
            android:maxLines="5"
            android:ellipsize="end" />

        <!-- 下载/引用页面链接 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下载/引用页面链接"
            android:textSize="14sp"
            android:textColor="#E0E0E0"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etReferrerUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="如果不确定，请留空"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:background="#616161"
            android:inputType="textUri" />

        <!-- 文件名 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="另存为："
            android:textSize="14sp"
            android:textColor="#E0E0E0"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etFileName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="文件名"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:background="#616161" />

        <!-- 大小 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="大小:"
            android:textSize="14sp"
            android:textColor="#E0E0E0"
            android:layout_marginTop="12dp" />

        <!-- 存储信息 -->
        <TextView
            android:id="@+id/tvStorageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="存储：31.06GB/226.10GB, 13.7% 可用"
            android:textSize="13sp"
            android:textColor="#FF9800"
            android:layout_marginTop="4dp" />

        <!-- 保存路径 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="#616161">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/file"
                android:tint="#FFFFFF"
                android:contentDescription="文件夹" />

            <TextView
                android:id="@+id/tvSavePath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="/storage/emulated/0/IDMP/Others"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <ImageView
                android:id="@+id/btnChangePath"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/enter"
                android:tint="#CCCCCC"
                android:contentDescription="选择路径" />
        </LinearLayout>

        <!-- 下载选项 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbWifiOnly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="仅限WiFi"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:checked="true"
                    android:buttonTint="#9C27B0" />

                <CheckBox
                    android:id="@+id/cbRetryOnError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="出错重试"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:checked="true"
                    android:buttonTint="#9C27B0" />

                <CheckBox
                    android:id="@+id/cbUseProxy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="使用代理"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#9C27B0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <CheckBox
                    android:id="@+id/cbHideFile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="隐藏文件"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#9C27B0" />

                <CheckBox
                    android:id="@+id/cbDownloadFirst"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="预先下载"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:checked="true"
                    android:buttonTint="#9C27B0" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbAdvancedSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="高级设置"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"
                android:buttonTint="#9C27B0" />
        </LinearLayout>

        <!-- 高级设置面板 -->
        <LinearLayout
            android:id="@+id/layoutAdvancedSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <!-- 类型 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="类型："
                android:textSize="14sp"
                android:textColor="#E0E0E0" />

            <Spinner
                android:id="@+id/spinnerFileType"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#616161"
                android:layout_marginTop="4dp"
                android:popupBackground="#616161" />

            <!-- 多线程数 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="多线程数："
                android:textSize="14sp"
                android:textColor="#E0E0E0"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="12sp"
                    android:textColor="#BBBBBB" />

                <SeekBar
                    android:id="@+id/seekBarThreads"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="31"
                    android:progress="0"
                    android:progressTint="#9C27B0"
                    android:thumbTint="#9C27B0"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvThreadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:minWidth="30dp"
                    android:gravity="end" />
            </LinearLayout>

            <!-- 下载速度限制 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="下载速度限制："
                android:textSize="14sp"
                android:textColor="#E0E0E0"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.0KB/s"
                    android:textSize="12sp"
                    android:textColor="#BBBBBB" />

                <SeekBar
                    android:id="@+id/seekBarSpeedLimit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#9C27B0"
                    android:thumbTint="#9C27B0"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最大"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:minWidth="50dp"
                    android:gravity="end" />
            </LinearLayout>

            <!-- 用户代理 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="用户代理："
                android:textSize="14sp"
                android:textColor="#E0E0E0"
                android:layout_marginTop="12dp" />

            <Spinner
                android:id="@+id/spinnerUserAgent"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#616161"
                android:layout_marginTop="4dp"
                android:popupBackground="#616161" />

            <!-- 自定义请求头 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自定义请求头："
                android:textSize="14sp"
                android:textColor="#E0E0E0"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etCustomHeaders"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="例如：&#10;Referer: https://example.com&#10;Cookie: session=xxx"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:padding="8dp"
                android:layout_marginTop="4dp"
                android:background="#616161"
                android:gravity="top|start"
                android:inputType="textMultiLine" />

        </LinearLayout>

        <!-- 按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/btnAddToQueue"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="添加"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#9C27B0"
                android:gravity="center"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="取消"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#CCCCCC"
                android:gravity="center"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="连接"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#9C27B0"
                android:gravity="center"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
