<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_config_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary"
            android:paddingBottom="16dp" />

        <!-- 链接显示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/download_config_link_label"
                android:textSize="14sp"
                android:textColor="@color/theme_text_secondary" />

            <TextView
                android:id="@+id/btnCopyUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_copy"
                android:textSize="14sp"
                android:textColor="@color/theme_primary"
                android:padding="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://example.com/video.m3u8"
            android:textSize="13sp"
            android:textColor="@color/theme_text_primary"
            android:padding="12dp"
            android:background="@color/surface_inset"
            android:layout_marginTop="8dp"
            android:maxLines="5"
            android:ellipsize="end" />

        <!-- 下载/引用页面链接 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_config_page_link"
            android:textSize="14sp"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etReferrerUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="如果不确定，请留空"
            android:textSize="13sp"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/theme_text_secondary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_dialog_input"
            android:inputType="textUri" />

        <!-- 文件名 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_config_save_as"
            android:textSize="14sp"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etFileName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="文件名"
            android:textSize="14sp"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/theme_text_secondary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_dialog_input" />

        <!-- 大小 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_config_size"
            android:textSize="14sp"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginTop="12dp" />

        <!-- 存储信息 -->
        <TextView
            android:id="@+id/tvStorageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="存储：31.06GB/226.10GB, 13.7% 可用"
            android:textSize="13sp"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginTop="4dp" />

        <!-- 保存位置：点这一行弹三档单选（默认 / 应用外部私有目录 / 应用内部缓存目录），
             选完存 download_settings / download_dir，只对之后新建的任务生效 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_config_save_path"
            android:textSize="14sp"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/layoutSavePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="4dp"
            android:padding="12dp"
            android:background="@drawable/bg_dialog_input"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/file"
                android:tint="@color/theme_text_secondary"
                android:contentDescription="文件夹" />

            <TextView
                android:id="@+id/tvSavePath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textSize="13sp"
                android:textColor="@color/theme_text_primary"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <ImageView
                android:id="@+id/btnChangePath"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/enter"
                android:tint="@color/theme_text_secondary"
                android:contentDescription="选择保存位置" />
        </LinearLayout>

        <!-- 下载选项 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbWifiOnly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/download_config_wifi_only"
                    android:textSize="14sp"
                    android:textColor="@color/theme_text_primary"
                    android:checked="true"
                    android:buttonTint="@color/theme_primary" />

                <CheckBox
                    android:id="@+id/cbRetryOnError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/download_config_retry_on_error"
                    android:textSize="14sp"
                    android:textColor="@color/theme_text_primary"
                    android:checked="true"
                    android:buttonTint="@color/theme_primary" />

                <CheckBox
                    android:id="@+id/cbUseProxy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/download_config_use_proxy"
                    android:textSize="14sp"
                    android:textColor="@color/theme_text_primary"
                    android:buttonTint="@color/theme_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <CheckBox
                    android:id="@+id/cbHideFile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/download_config_hide_file"
                    android:textSize="14sp"
                    android:textColor="@color/theme_text_primary"
                    android:buttonTint="@color/theme_primary" />

                <CheckBox
                    android:id="@+id/cbDownloadFirst"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/download_config_pre_download"
                    android:textSize="14sp"
                    android:textColor="@color/theme_text_primary"
                    android:checked="true"
                    android:buttonTint="@color/theme_primary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbAdvancedSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_config_advanced"
                android:textSize="14sp"
                android:textColor="@color/theme_text_primary"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/theme_primary" />
        </LinearLayout>

        <!-- 高级设置面板 -->
        <LinearLayout
            android:id="@+id/layoutAdvancedSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <!-- 类型 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_config_type"
                android:textSize="14sp"
                android:textColor="@color/theme_text_secondary" />

            <Spinner
                android:id="@+id/spinnerFileType"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_dialog_input"
                android:layout_marginTop="4dp"
                android:popupBackground="@drawable/bg_dialog_input" />

            <!-- 多线程数 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_config_threads"
                android:textSize="14sp"
                android:textColor="@color/theme_text_secondary"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="12sp"
                    android:textColor="@color/theme_text_secondary" />

                <SeekBar
                    android:id="@+id/seekBarThreads"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="31"
                    android:progress="0"
                    android:progressTint="@color/theme_primary"
                    android:thumbTint="@color/theme_primary"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvThreadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="12sp"
                    android:textColor="@color/theme_text_primary"
                    android:minWidth="30dp"
                    android:gravity="end" />
            </LinearLayout>

            <!-- 下载速度限制 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_config_speed_limit"
                android:textSize="14sp"
                android:textColor="@color/theme_text_secondary"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.0KB/s"
                    android:textSize="12sp"
                    android:textColor="@color/theme_text_secondary" />

                <SeekBar
                    android:id="@+id/seekBarSpeedLimit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/theme_primary"
                    android:thumbTint="@color/theme_primary"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最大"
                    android:textSize="12sp"
                    android:textColor="@color/theme_text_primary"
                    android:minWidth="50dp"
                    android:gravity="end" />
            </LinearLayout>

            <!-- 用户代理 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_config_user_agent"
                android:textSize="14sp"
                android:textColor="@color/theme_text_secondary"
                android:layout_marginTop="12dp" />

            <Spinner
                android:id="@+id/spinnerUserAgent"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_dialog_input"
                android:layout_marginTop="4dp"
                android:popupBackground="@drawable/bg_dialog_input" />

            <!-- 自定义请求头 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_config_custom_headers"
                android:textSize="14sp"
                android:textColor="@color/theme_text_secondary"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etCustomHeaders"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="例如：&#10;Referer: https://example.com&#10;Cookie: session=xxx"
                android:textSize="12sp"
                android:textColor="@color/theme_text_primary"
                android:textColorHint="@color/theme_text_secondary"
                android:padding="8dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_dialog_input"
                android:gravity="top|start"
                android:inputType="textMultiLine" />

        </LinearLayout>

        <!-- 按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/btnAddToQueue"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/download_config_add_to_queue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/theme_text_primary"
                android:gravity="center"
                android:background="@drawable/bg_dialog_button_secondary" />

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/theme_text_secondary"
                android:gravity="center"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/download_config_connect"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/theme_on_primary"
                android:gravity="center"
                android:background="@drawable/bg_dialog_button_primary" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
