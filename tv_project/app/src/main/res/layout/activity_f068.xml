<?xml version="1.0" encoding="utf-8"?>
<!-- MIME 映射与响应头（F068）：输入文件名/扩展名，直接给出类型、整组响应头、能否浏览器直播 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <!-- 页头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/f068_action_back"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_back"
                app:tint="@color/theme_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/f068_title"
                android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f068_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 输入区 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:text="@string/f068_section_input"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <EditText
            android:id="@+id/f068Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/bg_dialog_input"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/f068_input_hint"
            android:imeOptions="actionGo"
            android:inputType="text"
            android:maxLines="2"
            android:minHeight="48dp"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/theme_text_secondary"
            android:textSize="@dimen/text_body" />

        <EditText
            android:id="@+id/f068SizeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/bg_dialog_input"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/f068_size_hint"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:minHeight="48dp"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/theme_text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/f068_size_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:orientation="horizontal">

            <Button
                android:id="@+id/f068BtnProbe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:focusable="true"
                android:text="@string/f068_btn_probe" />

            <Button
                android:id="@+id/f068BtnUnknown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:focusable="true"
                android:text="@string/f068_btn_unknown" />
        </LinearLayout>

        <!-- 常用扩展名快捷入口 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:text="@string/f068_section_quick"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/f068_quick_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:focusable="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/f068Chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 结果区 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:text="@string/f068_section_result"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <TextView
            android:id="@+id/f068Ext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:text="@string/f068_ext_none"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:text="@string/f068_label_mime"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />

        <TextView
            android:id="@+id/f068Mime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="@string/f068_mime_placeholder"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle"
            android:textColor="@color/theme_primary"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:text="@string/f068_label_playable"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />

        <TextView
            android:id="@+id/f068Playable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/f068_playable_placeholder"
            android:textAppearance="@style/TextAppearance.TVPlayer.Body"
            android:textColor="@color/theme_text_primary" />

        <TextView
            android:id="@+id/f068PlaybackNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f068_playback_note_placeholder"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:text="@string/f068_label_size"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />

        <TextView
            android:id="@+id/f068SizeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/f068_size_placeholder"
            android:textAppearance="@style/TextAppearance.TVPlayer.Body"
            android:textColor="@color/theme_text_primary" />

        <!-- 完整响应头 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:text="@string/f068_label_headers"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <TextView
            android:id="@+id/f068Headers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/bg_card_surface"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="@dimen/card_padding"
            android:text="@string/f068_headers_placeholder"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_primary"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/f068_headers_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />

        <!-- 命中/回落说明 -->
        <TextView
            android:id="@+id/f068Note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:text="@string/f068_note_known"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />

        <!-- 接线说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:text="@string/f068_engine_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
