<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <!--
            加了 id 是为了让代码能 setTitle(剧名)：全页收起后只剩这条工具栏，
            写死「短剧详情」等于把用户唯一还看得见的标题浪费掉
        -->
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            app:contentScrim="@color/theme_primary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <!--
                封面圆角：sd_detail_cover_placeholder 提供 radius_xl 圆角 + surface_block 兜底底色，
                clipToOutline 才真的把图裁进去。兜底底色是必须的——bg_cover_xl 是透明底，
                图没加载出来时整块就是纯白，看着像封面丢了
            -->
            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/sd_detail_cover_placeholder"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                tools:src="@drawable/ic_placeholder"
                android:contentDescription="视频封面" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_overlay" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 加了 id 是为了「自动滚到上次看的集数」时能把这一层滚过去 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!--
                首屏骨架：详情还没回来时先把「标题 / 副信息 / 简介」三块的位置占住，
                免得页面只挂一个转圈、内容到位时整页往下跳。
                不引 shimmer 库，呼吸效果由代码里的 ObjectAnimator 改变 alpha 实现
            -->
            <LinearLayout
                android:id="@+id/sd_detail_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:id="@+id/sd_detail_skeleton_block1"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:background="@drawable/sd_detail_skeleton_block" />

                <View
                    android:id="@+id/sd_detail_skeleton_block2"
                    android:layout_width="160dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/sd_detail_skeleton_block" />

                <View
                    android:id="@+id/sd_detail_skeleton_block3"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/sd_detail_skeleton_block" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                android:textColor="@color/theme_text_primary"
                tools:text="短剧标题" />

            <LinearLayout
                android:id="@+id/rowAuthorType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvAuthor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/theme_text_secondary"
                    tools:text="作者: XXX" />

                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_tag"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/theme_accent"
                    tools:text="都市爱情" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowPlayStat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvPlayCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/theme_text_secondary"
                    tools:text="10万播放" />

                <TextView
                    android:id="@+id/tvEpisodeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/theme_text_secondary"
                    tools:text="共80集" />

            </LinearLayout>

            <!-- 年份 / 评分 / 完结状态：字段缺一项就少一项，全缺整行不显示（默认 gone，代码里判断） -->
            <TextView
                android:id="@+id/tvMetaInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/theme_text_secondary"
                android:visibility="gone"
                tools:text="2024 · 评分 8.5 · 已完结"
                tools:visibility="visible" />

            <!--
                主操作：一屏只留这一个实心按钮，文案由代码按「有没有本地进度」切换。
                分集没加载出来 / 一条都没有时整块 GONE（代码里控制），不留一个点了没反应的按钮
            -->
            <TextView
                android:id="@+id/btnPrimaryPlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="@string/short_drama_detail_play_first"
                android:textColor="@color/theme_on_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="继续看第12集"
                tools:visibility="visible" />

            <!-- 简介默认 3 行，超长才出「展开」，避免长简介把选集挤到屏幕外 -->
            <TextView
                android:id="@+id/tvIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:textSize="@dimen/text_body"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/theme_text_primary"
                tools:text="剧情简介..." />

            <TextView
                android:id="@+id/tvIntroToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingEnd="8dp"
                android:text="@string/short_drama_detail_expand"
                android:textSize="13sp"
                android:textColor="@color/theme_accent"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/common_episodes"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text_primary" />

                <!--
                    跳集入口：百集以上靠「展开全部」翻不动，输入集号直接定位更实用。
                    放在「上次看到」角标左边，保证角标永远是这一行最靠右、位置最稳定的那个
                -->
                <TextView
                    android:id="@+id/tvJumpEpisode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tag"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/short_drama_detail_jump"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/theme_text_secondary"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- 上次看到的集数角标：有进度才显示，点一下直接跳到那一集 -->
                <TextView
                    android:id="@+id/tvProgressHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_tag"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/theme_accent"
                    android:visibility="gone"
                    tools:text="上次看到第12集"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- 播放源切换：只有一个源时不显示（代码里控制 visibility） -->
            <HorizontalScrollView
                android:id="@+id/sourceScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/sourceChipRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <!-- 选集列表 - 使用 wrap_content 让它自动扩展；集数由代码分批（默认 30） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- 展开全部 / 收起 -->
            <TextView
                android:id="@+id/tvEpisodeExpand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:textSize="@dimen/text_body"
                android:textColor="@color/theme_accent"
                android:visibility="gone"
                tools:text="展开全部（共 120 集）"
                tools:visibility="visible" />

            <!--
                空态 / 失败重试共用这一块：文案和可点性由代码切换。
                高度改 wrap_content + minHeight：失败原因可能折成两行，写死 100dp 会被截掉
            -->
            <TextView
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="100dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:text="@string/short_drama_detail_no_episodes"
                android:textSize="@dimen/text_body"
                android:textColor="@color/theme_text_secondary"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>