<?xml version="1.0" encoding="utf-8"?>
<!--
  「快进快退步长策略」页 · 沿用外观主题页的 FlClash 视觉语言：
  卡片层 + 16dp 圆角，焦点态靠 bg_card_surface 的 surface_inset 填充表达，不额外描边。
  电视没有触摸屏，所有可操作控件都 focusable，并用 nextFocus* 显式串好 D-Pad 路径。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/f009_title"
            android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f009_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 小节：步长 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f009_section_step"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <RadioGroup
                    android:id="@+id/f009StepGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/f009_step5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_surface"
                        android:buttonTint="@color/theme_primary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:minHeight="@dimen/list_row_min_height"
                        android:nextFocusDown="@id/f009_step10"
                        android:nextFocusUp="@id/f009_step5"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/f009_step_5"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/f009_step10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:background="@drawable/bg_card_surface"
                        android:buttonTint="@color/theme_primary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:minHeight="@dimen/list_row_min_height"
                        android:nextFocusDown="@id/f009_step30"
                        android:nextFocusUp="@id/f009_step5"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/f009_step_10"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/f009_step30"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:background="@drawable/bg_card_surface"
                        android:buttonTint="@color/theme_primary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:minHeight="@dimen/list_row_min_height"
                        android:nextFocusDown="@id/f009_step60"
                        android:nextFocusUp="@id/f009_step10"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/f009_step_30"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/f009_step60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:background="@drawable/bg_card_surface"
                        android:buttonTint="@color/theme_primary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:minHeight="@dimen/list_row_min_height"
                        android:nextFocusDown="@id/f009SmartSwitch"
                        android:nextFocusUp="@id/f009_step30"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/f009_step_60"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/f009StepSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：智能模式 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f009_section_smart"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- 整行可聚焦，确认键切换 -->
                <LinearLayout
                    android:id="@+id/f009SmartSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_min_height"
                    android:nextFocusUp="@id/f009_step60"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f009_smart_label"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/f009SmartState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f009_smart_off_summary"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                        android:textColor="@color/theme_text_secondary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/f009_smart_desc"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：模拟播放区 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f009_section_demo"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/f009PositionValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                    android:textColor="@color/theme_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- 只做展示：电视上 D-Pad 左右键留给焦点导航，位置由下面两个按钮微调 -->
                <SeekBar
                    android:id="@+id/f009Seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:focusable="false"
                    android:max="1000"
                    android:progress="0"
                    android:progressBackgroundTint="@color/surface_inset"
                    android:progressTint="@color/theme_primary"
                    android:splitTrack="false"
                    android:thumbTint="@color/theme_primary" />

                <!-- 位置微调：电视没有触摸屏，进度条只做展示，定位靠这两个 30 秒按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/f009NudgeBack"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:nextFocusUp="@id/f009SmartSwitch"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/f009_nudge_back"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                            android:textColor="@color/theme_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/f009NudgeForward"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:nextFocusLeft="@id/f009NudgeBack"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/f009_nudge_forward"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                            android:textColor="@color/theme_text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/f009ResetPosition"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:nextFocusUp="@id/f009NudgeBack"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/f009_reset_position"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                            android:textColor="@color/theme_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/f009BtnForward"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:nextFocusDown="@id/f009BtnSetCredits"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/f009_action_forward"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                            android:textColor="@color/theme_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/f009BtnSetIntro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:nextFocusUp="@id/f009ResetPosition"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/f009_set_intro"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/f009BtnSetCredits"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:nextFocusLeft="@id/f009BtnSetIntro"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/f009_set_credits"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 标记可视化：两行分别显示片头结束、片尾开始 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_mode_row"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/f009_intro_label"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                        <TextView
                            android:id="@+id/f009IntroValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/f009_mark_none"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Body" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/f009_credits_label"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                        <TextView
                            android:id="@+id/f009CreditsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/f009_mark_none"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Body" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/f009MarksHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/f009_marks_hint_off"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <LinearLayout
                    android:id="@+id/f009BtnBackward"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_card_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:nextFocusUp="@id/f009BtnSetCredits"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f009_action_backward"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/f009BtnClearMarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_card_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:nextFocusUp="@id/f009BtnBackward"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f009_clear_marks"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：这次跳转的结果 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f009_section_result"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:minHeight="96dp"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/f009Result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/f009_result_idle"
                android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                android:textColor="@color/theme_primary" />

            <TextView
                android:id="@+id/f009BoundaryTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                android:textColor="@color/theme_error" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:text="@string/f009_player_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>