<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_gradient_bg"
    android:fitsSystemWindows="true">

    <!-- Logo和标题 -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_pv"
            android:background="@drawable/circle_white_bg"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="172号卡"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 登录卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="32dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Tab切换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/tab_container_bg"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tvLoginTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="登录"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/tab_selected_bg" />

                <TextView
                    android:id="@+id/tvRegisterTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="注册"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="15sp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- 邮箱输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/center"
                    app:tint="@color/theme_text_secondary" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:hint="请输入邮箱"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="15sp"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- 验证码输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lw"
                        app:tint="@color/theme_text_secondary" />

                    <EditText
                        android:id="@+id/etCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:hint="验证码"
                        android:textColorHint="@color/theme_text_secondary"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp"
                        android:inputType="number"
                        android:maxLines="1"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnGetCode"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="获取验证码"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:background="@drawable/button_blue_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <!-- 密码输入（注册时显示） -->
            <LinearLayout
                android:id="@+id/layoutPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lw"
                    app:tint="@color/theme_text_secondary" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:hint="设置密码"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="15sp"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- 确认密码输入（注册时显示） -->
            <LinearLayout
                android:id="@+id/layoutConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lw"
                    app:tint="@color/theme_text_secondary" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:hint="确认密码"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="15sp"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- 自动登录和记住密码（登录时显示） -->
            <LinearLayout
                android:id="@+id/layoutLoginOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <CheckBox
                    android:id="@+id/cbAutoLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动登录"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="13sp"
                    android:buttonTint="?attr/colorPrimary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <CheckBox
                    android:id="@+id/cbRememberPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="记住密码"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="13sp"
                    android:checked="true"
                    android:buttonTint="?attr/colorPrimary" />
            </LinearLayout>

            <!-- 登录/注册按钮 -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="登录"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:background="@drawable/button_blue_bg"
                android:layout_marginBottom="16dp" />

            <!-- 去注册和忘记密码 -->
            <LinearLayout
                android:id="@+id/layoutBottomLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="还没有账号？"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSwitchMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="去注册"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="忘记密码"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- 协议 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/cbAgree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:buttonTint="?attr/colorPrimary"
                    android:scaleX="0.8"
                    android:scaleY="0.8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我已同意平台"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/tvServiceAgreement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="《服务协议》"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_caption"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="和"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/tvPrivacyPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="《隐私政策》"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_caption"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 其他快捷登录 -->
    <LinearLayout
        android:id="@+id/layoutOtherLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardLogin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="其他快捷登录"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivWechatLogin"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="24dp"
                android:src="@drawable/ic_pv"
                android:background="@drawable/circle_white_bg"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/theme_success" />

            <ImageView
                android:id="@+id/ivAlipayLogin"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_pv"
                android:background="@drawable/circle_white_bg"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/theme_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部提示 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="本系统仅限于'172号卡'用户使用"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_caption"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
