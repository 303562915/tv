<?xml version="1.0" encoding="utf-8"?>
<!--
  短剧卡片。
  改动说明（为什么）：
  1. 封面原来写死 160dp 高，列数一多（平板 4~5 列）卡片变窄就会把竖版封面压扁/裁变形，
     改成按 3:4 比例算高，列数怎么变都不变形。
  2. 加「完结」角标（盖在封面右上），复用现成的 bg_tag_orange / theme_warning 配色，
     不新增 drawable 资源。
  3. 加「看到第 N 集」一行（只在有进度时显示），用主题色与集数/评分/播放量区分开。
  4. 卡片加点击/焦点能力 + 前景水波纹：原来根节点点击没有按压反馈，点下去像没反应。
  5. 标题固定占两行高度（minLines=2 + gravity=top）：单行标题与两行标题的卡片等高，
     否则同一行网格里卡片一高一低。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/radius_sm"
    app:cardElevation="2dp"
    android:minHeight="48dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 3:4 竖版封面：宽随列宽，高按比例算，列数变化不变形 -->
        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/surface_inset"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="H,3:4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_placeholder"
            android:contentDescription="视频封面" />

        <!-- 完结角标：只有 finished=true 才显示 -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_tag_orange"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="@string/short_drama_finished"
            android:textColor="@color/theme_warning"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/ivCover"
            app:layout_constraintTop_toTopOf="@id/ivCover"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="top"
            android:maxLines="2"
            android:minLines="2"
            android:padding="8dp"
            android:textColor="@color/theme_text_primary"
            android:textSize="@dimen/text_body"
            app:layout_constraintTop_toBottomOf="@id/ivCover"
            tools:text="短剧标题" />

        <!-- 左：分类 · 集数 · 年份（空值不拼，绝不出现孤立的「集」字）。
             限定 1 行 + 末尾省略：多拼了一个分类后文字更长，不限行会折行把卡片撑高，
             同一行网格里的卡片就一高一低了。 -->
        <TextView
            android:id="@+id/tvEpisodes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:textColor="@color/theme_text_secondary"
            android:textSize="@dimen/text_caption"
            app:layout_constraintEnd_toStartOf="@id/tvPlayCount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            tools:text="都市 · 80集 · 2023" />

        <!-- 右：评分优先，没有评分再退回播放量 -->
        <TextView
            android:id="@+id/tvPlayCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/theme_text_secondary"
            android:textSize="@dimen/text_caption"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvEpisodes"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            tools:text="9.2分" />

        <!-- 继续观看：仅当进度 episodeNum > 0 时显示，用主题色做区分 -->
        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/theme_primary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEpisodes"
            tools:text="看到第12集"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>