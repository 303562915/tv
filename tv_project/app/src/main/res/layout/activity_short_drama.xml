<?xml version="1.0" encoding="utf-8"?>
<!--
  免费短剧列表：一层工具条（返回 + 标题）+ 搜索框 + 热门词 chip 行 + 分类 Tab + 下拉刷新的格子列表 + 底部状态 footer。
  本次改动（为什么）：
  1. etSearch 改成 AutoCompleteTextView：搜索历史直接用系统下拉呈现，不额外写弹层（零新布局文件）。
  2. 新增 chipRow：进入搜索态 / 搜不到结果时给一排热门词，点一下就能搜，少打字。
  3. 内容区包一层竖向 LinearLayout，把三态 footer（加载中 / 没有更多 / 加载失败点我重试）固定在列表底部，
     而不是浮在卡片上；SwipeRefresh 的子 View 变成 LinearLayout，需要在代码里指定 canChildScrollUp 回调，
     否则列表往下滚的时候下拉还会误触发刷新。
  4. 新增 skeletonRecycler：首屏加载用 6 个占位卡片铺网格，比一句「加载中…」更少跳动。
  5. 搜索行右侧新增 btnClearSearch：清空只能逐字删太难用，给一个一键清除；
     etSearch 同时从 match_parent 改成 0dp + weight=1，把这个 44dp 从输入框宽度里让出来，不撑破一行。
  6. tvFooter 从 36dp 抬到 48dp 并加涟漪：它是「加载失败，点我重试」的唯一入口，
     原来热区只有文字高度，点不中也没有按下反馈。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/page_toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- 返回：44dp 触摸区，图标 24dp -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:tint="@color/theme_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:gravity="start"
            android:text="@string/free_short_drama"
            android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

    </LinearLayout>

    <!-- 搜索：与搜索页同一套胶囊输入框；有关键词时隐藏分类 Tab，清空即回到分类 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <AutoCompleteTextView
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/search_input_bg"
            android:completionThreshold="1"
            android:hint="搜短剧名"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/theme_text_secondary"
            android:textSize="14sp" />

        <!-- 清除按钮：输入框让出 44dp 给这里，免得长词只能一个字一个字删。
             为什么用 TextView + 「✕」字形而不是 ImageView：不新增 drawable 资源文件，
             字形本身就能居中，也不用为深浅色各画一套。 -->
        <TextView
            android:id="@+id/btnClearSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="16sp"
            android:textColor="@color/theme_text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="清除搜索词"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 热门词 chip 行：默认隐藏，进入搜索态 / 搜不到时出现 -->
    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="@color/theme_primary"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/theme_primary"
        app:tabTextColor="@color/theme_text_secondary" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp" />

                <!-- 首屏骨架：6 个占位卡片，和真实网格同一套 LayoutManager，列数一致 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/skeletonRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/emptyView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="暂无短剧"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="16sp"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- 三态 footer：加载中 / 没有更多了 / 加载失败，点我重试 -->
            <!-- 48dp 是 Android 的最小点按热区：这一行在失败态是可点重试的入口，
                 原来 minHeight=36dp、上下内边距不对称，热区只有文字高度且没有按下反馈，
                 所以抬到 48dp、上下各 12dp 让文字垂直居中（gravity=center 已有），并补一条涟漪 -->
            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/theme_text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="没有更多了"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>