<?xml version="1.0" encoding="utf-8"?>
<!--
    竖屏播放器「视频下方信息区」：腾讯视频竖屏播放页结构
    ① Tab 行（详情 / 二创 / 讨论）  ② 标题 + 简介入口  ③ 标签行  ④ 功能行  ⑤ 选集区
    配色只用已有 token：theme_background / theme_text_primary / detail_action_tint / theme_primary / surface_inset
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/portraitDetailSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/theme_background">

    <!-- ① Tab 行：详情 / 二创 / 讨论 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingTop="12dp">

        <LinearLayout
            android:id="@+id/tabRowContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <!-- 详情（默认选中） -->
            <LinearLayout
                android:id="@+id/tabRowDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:minHeight="48dp">

                <TextView
                    android:id="@+id/tabTextDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="详情"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/tabUnderlineDetail"
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/theme_primary" />
            </LinearLayout>

            <!-- 二创 -->
            <LinearLayout
                android:id="@+id/tabRowErci"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:minHeight="48dp">

                <TextView
                    android:id="@+id/tabTextErci"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="二创"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="15sp" />

                <View
                    android:id="@+id/tabUnderlineErci"
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/theme_primary"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- 讨论（有计数才显示小红点徽标） -->
            <LinearLayout
                android:id="@+id/tabRowDiscuss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:minHeight="48dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tabTextDiscuss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="讨论"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="15sp" />

                    <!-- 讨论计数徽标：当前数据模型没有讨论数，默认隐藏 -->
                    <TextView
                        android:id="@+id/discussBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/bg_detail_dot_badge"
                        android:gravity="center"
                        android:minWidth="16dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="0"
                        android:textColor="@color/theme_on_error"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:id="@+id/tabUnderlineDiscuss"
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/theme_primary"
                    android:visibility="invisible" />
            </LinearLayout>

        </LinearLayout>

        <!-- Tab 行下细分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/surface_inset" />

    </LinearLayout>

    <!-- 详情内容区 -->
    <LinearLayout
        android:id="@+id/detailContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ② 标题 + 简介入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingTop="@dimen/page_margin">

            <!-- 标题 22sp 加粗 -->
            <TextView
                android:id="@+id/videoTitleDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="视频标题"
                android:textColor="@color/theme_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 简介展开 / 收起入口 -->
            <LinearLayout
                android:id="@+id/introExpandLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground"
                android:minHeight="48dp">

                <TextView
                    android:id="@+id/introLinkText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简介"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/introExpandIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/detail_action_tint"
                    android:importantForAccessibility="no" />
            </LinearLayout>

        </LinearLayout>

        <!-- 简介文本（默认收起，文案由代码用标题+视频信息拼） -->
        <TextView
            android:id="@+id/videoIntroText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:textColor="@color/theme_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 视频信息（原有文案：评分 · 播放量） -->
        <TextView
            android:id="@+id/videoInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:text="8.5分 · 8118播放"
            android:textColor="@color/theme_text_secondary"
            android:textSize="12sp" />

        <!-- ③ 标签行：胶囊标签，只显示已有数据 -->
        <LinearLayout
            android:id="@+id/tagRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin">

            <TextView
                android:id="@+id/tagRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tag_inset"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/theme_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tagPlayCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tag_inset"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/theme_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tagHd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tag_inset"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="高清"
                android:textColor="@color/theme_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tagVip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_inset"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="会员"
                android:textColor="@color/theme_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- ④ 功能行：下载 / 收藏 / 投屏 / 分享 / 解析（本站没有的功能不上这条行，5 个等分） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="@dimen/page_margin">

            <!-- 下载 -->
            <LinearLayout
                android:id="@+id/downloadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:minHeight="48dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_file_download_black_24dp"
                    app:tint="@color/detail_action_tint"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="下载"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 收藏 -->
            <LinearLayout
                android:id="@+id/favoriteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:minHeight="48dp">

                <ImageView
                    android:id="@+id/favoriteIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_favorite_border_black_24dp"
                    app:tint="@color/detail_action_tint"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="收藏"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 投屏 -->
            <LinearLayout
                android:id="@+id/castButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:minHeight="48dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_cast_black_24dp"
                    app:tint="@color/detail_action_tint"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="投屏"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 分享 -->
            <LinearLayout
                android:id="@+id/shareButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:minHeight="48dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_share_black_24dp"
                    app:tint="@color/detail_action_tint"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="分享"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 解析 -->
            <LinearLayout
                android:id="@+id/parseButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:minHeight="48dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_link_black_24dp"
                    app:tint="@color/detail_action_tint"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="解析"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ⑤ 选集区域 - 只显示一行横向滚动（结构 / 尺寸 / 配色保持不变） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingTop="@dimen/page_margin"
            android:paddingBottom="@dimen/page_margin">

            <!-- 选集标题和更多按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="选集"
                    android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

                <!-- 更多按钮 -->
                <LinearLayout
                    android:id="@+id/moreEpisodesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp"
                    android:minHeight="48dp">

                    <TextView
                        android:id="@+id/episodeCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全25集"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/detail_action_tint"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tab切换线路 - 横向滚动一行 -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutPortrait"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@android:color/transparent"
                app:tabMode="scrollable"
                app:tabIndicatorColor="@color/theme_primary"
                app:tabSelectedTextColor="@color/theme_primary"
                app:tabTextColor="@color/theme_text_secondary"
                app:tabIndicatorHeight="2dp"
                app:tabTextAppearance="@style/TabTextSmall"
                app:tabRippleColor="@null"
                app:tabPaddingStart="0dp"
                app:tabPaddingEnd="16dp" />

            <!-- 横向滚动的选集预览（只显示一行） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodeRecyclerViewDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>

    </LinearLayout>

    <!-- 二创 / 讨论 占位区（当前数据模型没有内容，只显示一行占位文本） -->
    <LinearLayout
        android:id="@+id/tabPlaceholderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tabPlaceholderText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="暂无内容"
            android:textColor="@color/theme_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
