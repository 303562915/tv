<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/portraitDetailSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/theme_background">

    <!-- 标题区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_margin">

        <!-- 标题 -->
        <TextView
            android:id="@+id/videoTitleDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="视频标题"
            android:textColor="@color/theme_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- 视频信息 -->
        <TextView
            android:id="@+id/videoInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="8.5分 · 8118播放"
            android:textColor="@color/detail_action_tint"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 功能按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/page_margin"
        android:gravity="center">

        <!-- 下载 -->
        <LinearLayout
            android:id="@+id/downloadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_file_download_black_24dp"
                app:tint="@color/detail_action_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="下载"
                android:textColor="@color/detail_action_tint"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 收藏 -->
        <LinearLayout
            android:id="@+id/favoriteButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/favoriteIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_favorite_border_black_24dp"
                app:tint="@color/detail_action_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="收藏"
                android:textColor="@color/detail_action_tint"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 投屏 -->
        <LinearLayout
            android:id="@+id/castButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cast_black_24dp"
                app:tint="@color/detail_action_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="投屏"
                android:textColor="@color/detail_action_tint"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 分享 -->
        <LinearLayout
            android:id="@+id/shareButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share_black_24dp"
                app:tint="@color/detail_action_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="分享"
                android:textColor="@color/detail_action_tint"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 解析 -->
        <LinearLayout
            android:id="@+id/parseButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_link_black_24dp"
                app:tint="@color/detail_action_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="解析"
                android:textColor="@color/detail_action_tint"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 选集区域 - 只显示一行横向滚动 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingBottom="@dimen/page_margin">

        <!-- 选集标题和更多按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选集"
                android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

            <!-- 更多按钮 -->
            <LinearLayout
                android:id="@+id/moreEpisodesButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">

                <TextView
                    android:id="@+id/episodeCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="全25集"
                    android:textColor="@color/detail_action_tint"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/detail_action_tint" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tab切换线路 - 横向滚动一行 -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutPortrait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            app:tabMode="scrollable"
            app:tabIndicatorColor="@color/theme_primary"
            app:tabSelectedTextColor="@color/theme_primary"
            app:tabTextColor="@color/detail_action_tint"
            app:tabIndicatorHeight="2dp"
            app:tabTextAppearance="@style/TabTextSmall"
            app:tabRippleColor="@null"
            app:tabPaddingStart="0dp"
            app:tabPaddingEnd="16dp" />

        <!-- 横向滚动的选集预览（只显示一行） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episodeRecyclerViewDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

    </LinearLayout>

</LinearLayout>