<?xml version="1.0" encoding="utf-8"?>
<!--
  「下集倒计时浮层」演示页 · 与外观主题页同一套视觉语言：
  表面靠 card / block / inset 三档递进，焦点只用 2dp primary 描边表达（bg_focus_ring）。
  TV 无触摸屏：所有可点元素都 focusable，D-Pad 上下直线可达。
  浮层是本文件末尾的 FrameLayout 覆盖层（visibility=gone），不额外起 Dialog，
  这样它天然跟着 Activity 的焦点链与主题走。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/pageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="96dp">

            <!-- 标题行：返回 + 页标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_secondary_button"
                    android:contentDescription="@string/f005_action_back"
                    android:focusable="true"
                    android:foreground="@drawable/bg_focus_ring"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_back"
                    app:tint="@color/theme_text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/f005_title"
                    android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/f005_desc"
                android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

            <!-- 小节：倒计时设置 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_gap"
                android:text="@string/f005_section_config"
                android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TVPlayer.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_surface"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_row_min_height"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/f005_label_seconds"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/btnSecondsMinus"
                            android:layout_width="48dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:text="@string/f005_action_minus"
                            android:textColor="@color/theme_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvSecondsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/card_gap"
                            android:layout_marginEnd="@dimen/card_gap"
                            android:gravity="center"
                            android:minWidth="72dp"
                            android:text="@string/f005_seconds_default"
                            android:textColor="@color/theme_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnSecondsPlus"
                            android:layout_width="48dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:text="@string/f005_action_plus"
                            android:textColor="@color/theme_primary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:background="@drawable/bg_tag_inset"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:text="@string/f005_range_hint"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 小节：模拟播放 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_gap"
                android:text="@string/f005_section_simulate"
                android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TVPlayer.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvNowPlaying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f005_now_playing_idle"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/tvEpisodeState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/f005_state_playing_idle"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <ProgressBar
                        android:id="@+id/progressCountdown"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="@dimen/card_gap"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/theme_primary"
                        android:progressBackgroundTint="@color/surface_inset" />

                    <TextView
                        android:id="@+id/tvRemaining"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/f005_remaining_empty"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <!-- 主操作：模拟到达片尾 -->
                    <TextView
                        android:id="@+id/btnStart"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="@dimen/card_padding"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f005_action_start"
                        android:textColor="@color/theme_primary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnCancel"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:text="@string/f005_action_cancel"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/btnContinue"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/card_gap"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:text="@string/f005_action_continue"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 小节：当前状态 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_gap"
                android:text="@string/f005_section_status"
                android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TVPlayer.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f005_status_idle"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/f005_hint_idle"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--
      下集提示浮层：模拟播放器上的覆盖层。
      底下压着整页控件，所以弹出时要挡住 pageContent 的焦点。
    -->
    <FrameLayout
        android:id="@+id/overlayCountdown"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/theme_scrim"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card.Raised"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f005_overlay_title"
                    android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

                <TextView
                    android:id="@+id/tvOverlayCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/f005_overlay_countdown_default"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="15sp" />

                <ProgressBar
                    android:id="@+id/progressOverlay"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="@dimen/card_gap"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/theme_primary"
                    android:progressBackgroundTint="@color/surface_inset" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding"
                    android:orientation="horizontal">

                    <!-- 主操作：立即播放下一集（默认焦点） -->
                    <TextView
                        android:id="@+id/btnOverlayPlayNext"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_primary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f005_action_play_next"
                        android:textColor="@color/theme_on_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnOverlayCancel"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f005_action_cancel_countdown"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</FrameLayout>