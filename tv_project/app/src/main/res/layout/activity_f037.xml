<?xml version="1.0" encoding="utf-8"?>
<!--
  「播放列表封面与描述」页 · 沿用功能页的 FlClash 视觉语言：
  卡片层 + 16dp 圆角，颜色只走 colors.xml 的 theme_* / surface_* 语义 token，
  这里不出现任何十六进制。

  结构：标题行 → 封面卡（大图 + 状态 + 选择/移除）→ 名称与描述卡 → 底部状态行 →
  保存按钮 → 「列表卡片预览」卡（封面 + 名称 + 描述 + 条目数）→ 引擎接线说明。

  电视没有触摸屏：返回 → 选择封面 → 移除封面 → 名称 → 描述 → 保存，
  nextFocus* 串成一条线；说明文字与预览卡不参与焦点，免得焦点掉进大段文字里出不来。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <!-- 标题行：返回 + 页标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/f037_action_back"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/f037PickCover"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/theme_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/f037_title"
                android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f037_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 封面 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f037_section_cover"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <!-- 封面大图：Glide 落地，未选封面时留 surface 底色 -->
                <ImageView
                    android:id="@+id/f037CoverImage"
                    android:layout_width="160dp"
                    android:layout_height="90dp"
                    android:background="@color/surface_block"
                    android:contentDescription="@string/f037_section_cover"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/f037_cover_hint"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                        android:textColor="@color/theme_text_secondary" />

                    <!-- 当前封面状态：未选 / 已选文件名；选图后由 Activity 填 -->
                    <TextView
                        android:id="@+id/f037CoverStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:text="@string/f037_cover_none"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                        android:textColor="@color/theme_accent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/f037PickCover"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusDown="@id/f037ClearCover"
                            android:text="@string/f037_action_pick_cover" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/f037ClearCover"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/card_gap"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusDown="@id/f037NameInput"
                            android:text="@string/f037_action_clear_cover" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 名称与描述 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f037_section_meta"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f037_label_name"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                    android:textColor="@color/theme_text_primary" />

                <!-- 名称：单行，长度上限与 F037Engine.MAX_NAME_LENGTH 一致 -->
                <EditText
                    android:id="@+id/f037NameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@color/surface_inset"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/f037_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="40"
                    android:maxLines="1"
                    android:nextFocusDown="@id/f037DescInput"
                    android:padding="@dimen/card_gap"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding"
                    android:text="@string/f037_label_desc"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                    android:textColor="@color/theme_text_primary" />

                <!-- 描述：多行，长度上限与 F037Engine.MAX_DESCRIPTION_LENGTH 一致 -->
                <EditText
                    android:id="@+id/f037DescInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@color/surface_inset"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="top|start"
                    android:hint="@string/f037_desc_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLength="200"
                    android:minLines="3"
                    android:nextFocusDown="@id/f037SaveButton"
                    android:padding="@dimen/card_gap"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary" />

                <!-- 状态行：已读取 / 已保存 / 权限不全 / 失败，语义色由 Activity 给 -->
                <TextView
                    android:id="@+id/f037StatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/f037_status_idle"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                    android:textColor="@color/theme_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/f037SaveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/f037NameInput"
            android:text="@string/f037_action_save" />

        <!-- 列表卡片预览 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f037_section_preview"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <!-- 预览小封面：与列表页卡片同一张图，Glide 按尺寸取缩略图 -->
                <ImageView
                    android:id="@+id/f037PreviewCover"
                    android:layout_width="96dp"
                    android:layout_height="54dp"
                    android:background="@color/surface_block"
                    android:contentDescription="@string/f037_section_preview"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/f037PreviewName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_text_primary" />

                    <TextView
                        android:id="@+id/f037PreviewDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/f037_preview_no_desc"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                        android:textColor="@color/theme_text_secondary" />

                    <TextView
                        android:id="@+id/f037PreviewCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                        android:textColor="@color/theme_accent" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:lineSpacingExtra="3dp"
            android:text="@string/f037_preview_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:lineSpacingExtra="3dp"
            android:text="@string/f037_engine_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:textColor="@color/theme_text_secondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>