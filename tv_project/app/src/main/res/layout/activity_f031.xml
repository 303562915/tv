<?xml version="1.0" encoding="utf-8"?>
<!--
  「观看时长周报」页 · 沿用 FlClash 视觉语言
  顶部一行是周切换（上一周 / 当周日期区间 / 下一周），中间一张卡片画 7 根竖条（一天一根），
  底部三个统计格并排：本周总量 / 日均 / 最长单日。
  柱子由 F031Activity 按当天时长等比设高度，布局里只留绘图容器。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/f031_title"
            android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f031_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 周切换：中间是 11月16日 - 11月22日，两侧翻周 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:nextFocusForward="@id/btnNext"
                android:nextFocusLeft="@id/btnNext"
                android:nextFocusRight="@id/btnNext"
                android:text="@string/f031_prev_week" />

            <TextView
                android:id="@+id/weekLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/f031_week_placeholder"
                android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                android:textColor="@color/theme_primary"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:nextFocusLeft="@id/btnPrev"
                android:nextFocusRight="@id/btnPrev"
                android:nextFocusForward="@id/btnPrev"
                android:text="@string/f031_next_week" />
        </LinearLayout>

        <TextView
            android:id="@+id/weekCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/f031_week_current"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 小节：柱状图 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f031_section_chart"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- 7 根柱子由 F031Activity 填，列高固定，柱子按比例贴底 -->
                <LinearLayout
                    android:id="@+id/chartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/chartScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/f031_chart_scale_empty"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <TextView
                    android:id="@+id/emptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/f031_empty"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                    android:textColor="@color/theme_warning"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：三个统计格 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f031_section_stats"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TVPlayer.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f031_stat_total_label"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <TextView
                        android:id="@+id/statTotalValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/theme_primary"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/f031_stat_total_caption"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TVPlayer.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_gap"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f031_stat_avg_label"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <TextView
                        android:id="@+id/statAvgValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/theme_primary"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/f031_stat_avg_caption"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TVPlayer.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_gap"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f031_stat_longest_label"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                    <TextView
                        android:id="@+id/statLongestValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/theme_primary"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statLongestDay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/f031_stat_longest_none"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                        android:textColor="@color/theme_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/bg_mode_row"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="@string/f031_hint_sample"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
