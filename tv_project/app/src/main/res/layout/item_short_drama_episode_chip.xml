<?xml version="1.0" encoding="utf-8"?>
<!--
  选集网格单元。
  为什么套一层无 id 的 FrameLayout：格子要「整格可点」，
  同时文字控件需要一个明确的 id（binding 的 chipText 指向它）。
  高度写死 44dp 是为了让 ShortDramaEpisodeSheet 能用「行数 x 固定行高」直接算出网格高度，
  不去做 wrap_content 的全量测量（200+ 集的面板那样会很卡）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_margin="4dp">

    <TextView
        android:id="@+id/chipText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/sd_bg_episode_chip"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/episode_chip_text"
        android:textSize="@dimen/text_body"
        tools:text="第12集" />

</FrameLayout>
