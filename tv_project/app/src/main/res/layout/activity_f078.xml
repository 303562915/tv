<?xml version="1.0" encoding="utf-8"?>
<!--
  「设置分组重置」页 · 沿用功能页的 FlClash 视觉语言：
  卡片层 + 16dp 圆角，焦点态靠 bg_primary_button / bg_secondary_button 的 selector 表达，不额外描边。
  颜色只走 colors.xml 的 theme_* / surface_* 语义 token，这里不出现任何十六进制。

  结构：标题行（返回 + 页标题）→ 一句说明 → 汇总卡片（已改 / 共几项 / 几个分组 + 全部重置）
        → 分组明细标题 → 分组容器（分组头 + 设置行，全部由代码生成）→ 状态行 → 页脚说明。

  分组与设置行都由 F078Activity 动态生成：12 项分 7 组，每组还有「重置本组」按钮，
  写成 XML 会变成 7 段重复结构 + 12 个 id，反而更难和引擎里的键清单对应上。
  静态布局只给容器 f078GroupList。

  电视遥控器：
  · 返回 → 全部重置按钮串了 nextFocusDown，进页面按一下下键就落到「全部重置」；
  · 分组里的「重置本组」与设置行自己可聚焦、可点击，焦点顺序就是加入顺序，不再单独串 nextFocus。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <!-- 标题行：返回 + 页标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/f078_action_back"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/f078ResetAll"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/theme_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/f078_title"
                android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f078_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 汇总卡片：当前状态 + 全部重置 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f078_summary_label"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <TextView
                    android:id="@+id/f078Summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="@dimen/text_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/f078_summary_hint"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <TextView
                    android:id="@+id/f078ResetAll"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:minWidth="160dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/f078_action_reset_all"
                    android:textColor="@color/theme_on_primary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 分组明细 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f078_section_groups"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <LinearLayout
            android:id="@+id/f078GroupList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/f078Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/theme_text_secondary"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:lineSpacingExtra="2dp"
            android:text="@string/f078_footer_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
