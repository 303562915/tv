<?xml version="1.0" encoding="utf-8"?>
<!-- 音量/亮度调节提示布局（仿腾讯视频） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gestureHintContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/gesture_hint_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone">

    <!-- 粗调模式：大图标 + 进度条 -->
    <LinearLayout
        android:id="@+id/coarseAdjustLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 大图标 -->
        <ImageView
            android:id="@+id/gestureIconLarge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="音量/亮度图标"
            android:tint="@color/theme_text_primary" />

        <!-- 进度条 -->
        <ProgressBar
            android:id="@+id/gestureProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/gesture_progress_bar" />

        <!-- 百分比文字 -->
        <TextView
            android:id="@+id/gesturePercentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="50%"
            android:textColor="@color/theme_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 细调模式：小图标 + 精确进度条 -->
    <LinearLayout
        android:id="@+id/fineAdjustLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- 小图标 -->
        <ImageView
            android:id="@+id/gestureIconSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="音量/亮度图标"
            android:tint="@color/theme_text_primary" />

        <!-- 精确进度条 -->
        <ProgressBar
            android:id="@+id/gestureProgressBarFine"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="150dp"
            android:layout_height="4dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/gesture_progress_bar_fine" />

        <!-- 百分比文字 -->
        <TextView
            android:id="@+id/gesturePercentTextFine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50%"
            android:textColor="@color/theme_text_primary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
