<?xml version="1.0" encoding="utf-8"?>
<!--
  「继续观看队列」页 · 沿用 FlClash 视觉语言
  上方是收录窗口（下界/上界两条滑杆 + 恢复默认），下方是队列卡片：
  队列行由 F030Activity 按当前窗口重建，布局里只留容器。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/f030_title"
            android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f030_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 小节：收录窗口 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f030_section_window"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/windowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f030_window_summary_default"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                    android:textColor="@color/theme_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/f030_hint_window"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <!-- 下界：进度 >= 该值才进队列 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f030_label_start"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/thresholdValueLow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/theme_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card_surface"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:max="100"
                    android:nextFocusDown="@id/seekEnd"
                    android:nextFocusForward="@id/seekEnd"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:progress="5"
                    android:progressBackgroundTint="@color/surface_inset"
                    android:progressTint="@color/theme_primary"
                    android:thumbTint="@color/theme_primary" />

                <!-- 上界：进度 <= 该值才进队列 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f030_label_end"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/thresholdValueHigh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/theme_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekEnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card_surface"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:max="100"
                    android:nextFocusDown="@id/btnReset"
                    android:nextFocusForward="@id/btnReset"
                    android:nextFocusUp="@id/seekStart"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:progress="95"
                    android:progressBackgroundTint="@color/surface_inset"
                    android:progressTint="@color/theme_primary"
                    android:thumbTint="@color/theme_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/f030_reset_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：继续观看队列 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f030_section_queue"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/statsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/f030_stats_placeholder"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <TextView
                    android:id="@+id/emptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="20dp"
                    android:text="@string/f030_empty"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/queueContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/bg_mode_row"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="@string/f030_hint_sample"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
