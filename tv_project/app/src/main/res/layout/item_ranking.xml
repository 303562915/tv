<?xml version="1.0" encoding="utf-8"?>
<!-- 排行行：FlClash 的分组行，靠填充与间距分组，不画分隔线 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/page_margin"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/page_margin"
    android:paddingBottom="12dp">

    <!-- 排名 -->
    <TextView
        android:id="@+id/tvRank"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/ranking_badge_bg"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/theme_text_secondary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 内容区域 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="白日提灯"
            android:textColor="@color/theme_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 平台和天数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlatform"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="腾讯视频独播"
                android:textColor="@color/theme_text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/tvOnlineDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_gap"
                android:text="上线18天"
                android:textColor="@color/theme_text_secondary"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

        <!-- 热量 -->
        <TextView
            android:id="@+id/tvHeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="实时热量 7244.03 万"
            android:textColor="@color/theme_warning"
            android:textSize="@dimen/text_caption" />

        <!-- 播放量（可选） -->
        <TextView
            android:id="@+id/tvPlayCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="实时播放量 6683.6 万"
            android:textColor="@color/theme_text_secondary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
