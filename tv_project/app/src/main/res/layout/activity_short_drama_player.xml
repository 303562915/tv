<?xml version="1.0" encoding="utf-8"?>
<!--
  竖屏短剧播放器外壳。
  这里只放「不随分集变化」的东西：ViewPager2 容器、返回按钮、全集播完的浮层。
  每集的画面与控件都在 item_short_drama_player_page.xml 里，滑到哪一集就由那一页自己管自己的进度条。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 竖向翻页：上滑下一集、下滑上一集，ViewPager2 自己保证不越界 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 返回：截图级沉浸页里这是唯一能退出的显式入口，所以做成 44dp 触摸热区 -->
    <ImageButton
        android:id="@+id/backBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/sd_bg_circle_scrim"
        android:contentDescription="返回"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/sd_ic_back"
        android:stateListAnimator="@null" />

    <!--
      全集播完浮层：整层可点是为了「不选按钮直接点一下」也能回到播放状态，
      面板自身也设成可点，避免点面板穿透到下面触发关闭。
    -->
    <LinearLayout
        android:id="@+id/finishOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/theme_scrim"
        android:clickable="true"
        android:contentDescription="关闭提示，继续观看"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/finishPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sd_bg_panel_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:orientation="vertical"
            android:padding="24dp"
            android:minHeight="48dp">

            <TextView
                android:id="@+id/tvFinishTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已看完全集"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFinishHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="下滑可以回看上一集"
                android:textColor="@color/player_control_icon_dim"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnReplay"
                    android:layout_width="128dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="重播本集"
                    android:textColor="@color/theme_on_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/btnBackDetail"
                    android:layout_width="128dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_button_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="返回详情"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
