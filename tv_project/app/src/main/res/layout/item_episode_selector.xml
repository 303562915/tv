<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/episodeCard"
    style="@style/Widget.TVPlayer.Card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/surface_block"
    app:cardCornerRadius="@dimen/radius_sm"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <TextView
        android:id="@+id/episodeNameText"
        android:layout_width="wrap_content"
        android:minWidth="64dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="16sp"
        android:textColor="@color/theme_text_primary"
        tools:text="01" />

</com.google.android.material.card.MaterialCardView>