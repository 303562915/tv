<?xml version="1.0" encoding="utf-8"?>
<!--
  「视图模式切换」页 · 沿用 FlClash 视觉语言
  自上而下：标题与说明 → 两张模式开关 → 两页的位置说明 → 卡片列表 → 底部提示。
  开关的两种状态分开表达：选中态换底图（primary 描边卡片），焦点态走 foreground 描边，
  遥控器走到哪、当前选的是哪个，一眼分得清。
  卡片的网格 / 列表两种形态由 F041Activity 运行时构建，布局里只留列表容器。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_margin"
    android:paddingTop="@dimen/page_margin"
    android:paddingEnd="@dimen/page_margin"
    android:paddingBottom="@dimen/card_gap">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/f041_title"
        android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/f041_desc"
        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

    <!-- 小节：浏览模式 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_padding"
        android:layout_marginBottom="@dimen/card_gap"
        android:text="@string/f041_section_view"
        android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/modeGridRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:foreground="@drawable/bg_focus_ring"
            android:gravity="center"
            android:minHeight="@dimen/list_row_min_height"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/f041_btn_grid"
                android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                android:textColor="@color/theme_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modeListRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:foreground="@drawable/bg_focus_ring"
            android:gravity="center"
            android:minHeight="@dimen/list_row_min_height"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/f041_btn_list"
                android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                android:textColor="@color/theme_text_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 两页的位置说明：本页实时位置 + 另一页记住的位置，切页时能立刻对上 -->
    <TextView
        android:id="@+id/modeStat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:text="@string/f041_status_pending"
        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

    <TextView
        android:id="@+id/scrollStat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/f041_scroll_pending"
        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

    <TextView
        android:id="@+id/otherStat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/f041_other_pending"
        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cardList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/card_gap"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:background="@drawable/bg_mode_row"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/f041_hint"
        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
</LinearLayout>
