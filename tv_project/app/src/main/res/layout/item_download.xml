<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.TVPlayer.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp">

        <!-- 多段进度背景容器 - 覆盖整个item -->
        <LinearLayout
            android:id="@+id/llSegmentedProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone">
            <!-- 动态添加分段背景 -->
        </LinearLayout>

        <!-- 单一进度条背景 - 普通下载使用 -->
        <View
            android:id="@+id/progressBackground"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/surface_block" />

        <!-- 内容层 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical">

            <!-- 左侧图标井：勾选框和电影胶片图标在同一位置 -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_icon_well">

                <!-- 左侧电影胶片图标 - 始终显示 -->
                <ImageView
                    android:id="@+id/ivIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_film_gray"
                    android:scaleType="fitCenter"
                    android:layout_gravity="center"
                    app:tint="@color/theme_text_secondary"
                    android:contentDescription="文件图标" />

                <!-- 勾选框 - 选择模式且选中时覆盖显示 -->
                <ImageView
                    android:id="@+id/ivCheckmark"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_mtrl_checked_circle"
                    android:scaleType="fitCenter"
                    android:layout_gravity="center"
                    app:tint="@color/theme_primary"
                    android:visibility="gone"
                    android:contentDescription="已选中" />
            </FrameLayout>

            <!-- 中间内容 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <!-- 文件名 -->
                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1920x1040~sOZy9HAUjr.mp4 (继传: 确定)"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/theme_text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <!-- 状态信息行 -->
                <TextView
                    android:id="@+id/tvStatusLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="10% | 100MB - 第 20 个，共 3238 个"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/theme_text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <!-- 多线程进度条容器 -->
                <LinearLayout
                    android:id="@+id/llMultiThreadProgress"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <!-- 动态添加分段进度条 -->
                </LinearLayout>

                <!-- 错误信息 -->
                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="错误: HTTP 403 Forbidden"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/theme_error"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 右侧状态和按钮 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="end|center_vertical"
                android:layout_marginStart="8dp">

                <!-- 续传状态 - 隐藏 -->
                <TextView
                    android:id="@+id/tvResumeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(续传: 确定)"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/theme_text_secondary"
                    android:gravity="end"
                    android:visibility="gone" />

                <!-- 状态和时间（同一行，和左侧状态行对齐） -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 状态文字 -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已暂停"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/theme_text_secondary" />

                    <!-- 剩余时间 -->
                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 3s"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/theme_text_secondary"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 右侧暂停/播放按钮 -->
            <ImageButton
                android:id="@+id/ivPlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp"
                android:src="@drawable/album_pause_btn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:contentDescription="暂停" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>