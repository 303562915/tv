<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <!-- 顶栏：不铺底色，搜索胶囊是唯一填充 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchBox"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/card_gap"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:cardBackgroundColor="@color/surface_inset"
            app:cardCornerRadius="@dimen/radius_full"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/theme_text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/card_gap"
                    android:layout_weight="1"
                    android:text="@string/home_search_filter"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="15sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/ivHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="观看历史"
            android:padding="8dp"
            android:src="@drawable/history"
            app:tint="@color/theme_text_secondary" />

        <!-- 短剧入口：与搜索胶囊同一套填充，点了进「免费短剧」列表 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chipShortDrama"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/card_gap"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:cardBackgroundColor="@color/surface_inset"
            app:cardCornerRadius="@dimen/radius_full"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/free_short_drama"
                android:textColor="@color/theme_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!--
        首页轮播：数据由 HomeFragment 从当前分类首屏里有封面的前几条派生，没数据时整块 GONE，
        不留「占着 180dp 却一片空白」的坑（GONE 时 ConstraintLayout 会把这块折成 0 高）。
    -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="0dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!--
            自动轮播不依赖焦点：pager 自己不聚焦，页内的卡片也不许抢焦点，
            这样遥控器上下换页时不会卡在轮播里。
        -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/bannerViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="blocksDescendants"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/indicatorContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="15dp"
            android:orientation="horizontal"
            android:padding="4dp" />

        <!--
            折叠开关是全屏唯一需要遥控器操作的轮播控件，所以只有它保留可聚焦：
            从列表往上按能停在这里，按一下收起 / 展开；pager 本身仍然不抢焦点。
        -->
        <ImageView
            android:id="@+id/bannerToggleIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:alpha="0.6"
            android:background="@drawable/circle_background"
            android:clickable="true"
            android:contentDescription="收起或展开轮播图"
            android:focusable="true"
            android:padding="16dp"
            android:src="@drawable/ic_expand_more" />

    </FrameLayout>

    <!-- 继续播放卡片：卡上一行，填充表达结构 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContinuePlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="@dimen/card_gap"
        android:layout_marginEnd="@dimen/page_margin"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bannerContainer"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/tvContinuePlayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:text="@string/common_continue_label"
                android:textColor="@color/theme_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/play"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 分类 Tab：选中 primary，未选中 onSurfaceVariant，无下划线 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardContinuePlay"
        app:tabIndicatorHeight="0dp"
        app:tabMinWidth="60dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="@dimen/tab_padding"
        app:tabPaddingStart="@dimen/tab_padding"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="@color/theme_primary"
        app:tabTextAppearance="@style/TabTextAppearance"
        app:tabTextColor="@color/theme_text_secondary" />

    <!--
        ViewPager2 自己不会滚，纵向滚动发生在当前页的 RecyclerView 上，
        父类只看 child.canScrollVertically(-1)（ViewPager2 恒为 false）会导致列表滚到中间再下拉也刷新，
        手势判定由 HomeFragment 里的 setOnChildScrollUpCallback 转问当前页的 RecyclerView。
    -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!--
        骨架屏：SwipeRefreshLayout 只允许一个直接子 View，所以用一块同位置的覆盖层当骨架，
        首屏加载时露出来、数据到达即隐藏（与空态 / 错误态由 HomeFragment 互斥控制）。
        灰块不进 XML：行数列数按真实网格在代码里生成，避免和 SPAN_COUNT 对不上。
    -->
    <FrameLayout
        android:id="@+id/skeletonContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/surface_page"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout">

        <LinearLayout
            android:id="@+id/skeletonGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="@dimen/card_gap"
            android:paddingEnd="@dimen/page_margin" />

    </FrameLayout>

    <!-- 空态：与历史、收藏同一套结构（图标 56dp + 标题 15sp 粗 + 说明 13sp + 可选按钮） -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_home"
            app:tint="@color/theme_outline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_empty"
            android:textColor="@color/theme_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/home_empty_hint"
            android:textColor="@color/theme_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- 错误态：复用空态结构，说明行写实际错误，按钮重新触发 ViewModel 加载 -->
    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_error"
            app:tint="@color/theme_outline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_load_failed"
            android:textColor="@color/theme_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/home_network_retry_hint"
            android:textColor="@color/theme_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnErrorRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/retry"
            android:textColor="@color/theme_primary"
            android:textSize="@dimen/text_body" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
