<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 播放器视图 -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="never"
        app:keep_content_on_player_reset="true"
        app:surface_type="texture_view"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- 字幕视图 -->
    <com.google.android.exoplayer2.ui.SubtitleView
        android:id="@+id/subtitleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom" />

    <!-- 加载提示 -->
    <LinearLayout
        android:id="@+id/loadingView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="正在缓冲"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
        
        <TextView
            android:id="@+id/bandwidthText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 缓冲小字：STATE_BUFFERING 时显示，复用 loadingView，不新增全屏遮罩 -->
        <TextView
            android:id="@+id/bufferingHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.85"
            android:text="缓冲中…"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 长按加速提示（顶部中间） -->
    <LinearLayout
        android:id="@+id/longPressSpeedLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="80dp"
        android:background="@drawable/speed_hint_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/longPressSpeedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.0X"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- 三个三角形动画 -->
        <LinearLayout
            android:id="@+id/speedArrowsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/speedArrow1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_play_arrow_small"
                android:tint="@color/player_control_icon"
                android:contentDescription="加速" />

            <ImageView
                android:id="@+id/speedArrow2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_play_arrow_small"
                android:tint="@color/player_control_icon"
                android:contentDescription="加速" />

            <ImageView
                android:id="@+id/speedArrow3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_play_arrow_small"
                android:tint="@color/player_control_icon"
                android:contentDescription="加速" />
        </LinearLayout>
    </LinearLayout>

    <!-- 进度调整遮罩层（整体变暗） -->
    <View
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/theme_overlay"
        android:visibility="gone" />

    <!-- 进度调整提示（中间大显示） -->
    <LinearLayout
        android:id="@+id/progressSeekLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/progress_seek_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <!-- 预览图 -->
        <ImageView
            android:id="@+id/progressPreviewImage"
            android:layout_width="240dp"
            android:layout_height="135dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="视频预览" />

        <!-- 时间显示 -->
        <TextView
            android:id="@+id/progressSeekTimeDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:text="05:07 / 44:44" />

        <!-- 粗进度条 -->
        <ProgressBar
            android:id="@+id/gestureProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="280dp"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/thick_progress_bar" />
    </LinearLayout>

    <!-- 手势反馈提示（音量/亮度用） -->
    <LinearLayout
        android:id="@+id/gestureHintLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/gesture_hint_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/gestureHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
    
    <!-- 音量/亮度调节（顶部，图标嵌入进度条内部左侧） -->
    <FrameLayout
        android:id="@+id/volumeBrightnessLayout"
        android:layout_width="wrap_content"
        android:layout_height="29dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="30dp"
        android:visibility="gone">
        
        <!-- 进度条在下层，固定顶部对齐 -->
        <ProgressBar
            android:id="@+id/volumeBrightnessProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="176dp"
            android:layout_height="29dp"
            android:layout_gravity="top|center_horizontal"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/volume_brightness_progress" />
        
        <!-- 图标在上层，固定顶部对齐 -->
        <ImageView
            android:id="@+id/volumeBrightnessIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="7dp"
            android:layout_marginTop="3.5dp"
            android:tint="@color/player_control_icon"
            android:elevation="2dp"
            android:contentDescription="音量/亮度" />
    </FrameLayout>

    <!-- 音量/亮度到边反馈：0% / 100% 时在进度条下方追加「（已到最小）/（已到最大）」，600ms 后恢复 -->
    <TextView
        android:id="@+id/volumeBrightnessBoundaryText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="64dp"
        android:background="@drawable/gesture_hint_background"
        android:backgroundTint="#CC101010"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 错误提示 -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="gone" />
    
    <!-- 网速质量提示 -->
    <TextView
        android:id="@+id/qualityHintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@drawable/gesture_hint_background"
        android:padding="12dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />
    
    <!-- 跳过片头按钮已移入顶部标题栏右侧（胶囊样式在 topToolbar 内） -->

    <!-- 即将播放下一集提示（小按钮样式） -->
    <Button
        android:id="@+id/nextEpisodeHintButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/gesture_hint_background"
        android:text="5秒后播放下一集"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:padding="12dp"
        android:visibility="gone" />

    <!-- 顶部工具栏 -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_top"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 状态栏：时间、网络、电量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/currentTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <!-- 网速显示 -->
            <TextView
                android:id="@+id/networkSpeedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:text="0 KB/s" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/networkStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/batteryIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:src="@android:drawable/ic_lock_idle_charging"
                android:tint="@color/player_control_icon" />
        </LinearLayout>

        <!-- 标题栏：左 = 返回 + 标题；右 = 跳过片头 / TV 投屏 / 分享 / 更多 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:padding="8dp"
                android:src="@drawable/ic_back_tencent_style"
                android:scaleType="centerInside"
                android:tint="@color/player_control_icon" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/player_control_text"
                android:textSize="16sp" />

            <!-- 跳过片头（胶囊按钮，横屏顶部右侧） -->
            <Button
                android:id="@+id/skipIntroButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/speed_hint_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="跳过片头"
                android:textColor="@color/player_control_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- TV 投屏 -->
            <LinearLayout
                android:id="@+id/castButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="TV 投屏"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cast"
                    android:tint="@color/player_control_icon" />

                <TextView
                    android:id="@+id/castLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="TV 投屏"
                    android:textColor="@color/player_control_text"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 分享 -->
            <LinearLayout
                android:id="@+id/shareButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="分享"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/share"
                    android:tint="@color/player_control_icon" />

                <TextView
                    android:id="@+id/shareLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="分享"
                    android:textColor="@color/player_control_text"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 更多 -->
            <LinearLayout
                android:id="@+id/menuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="更多"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/dots_vertical"
                    android:tint="@color/player_control_icon" />

                <TextView
                    android:id="@+id/menuLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="更多"
                    android:textColor="@color/player_control_text"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 检测到更快路线提示 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fasterRouteHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="100dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/theme_primary"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:id="@+id/fasterRouteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="检测到更快路线"
                android:textColor="@color/theme_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fasterRouteInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="线路1 (1200KB/s)"
                android:textColor="@color/theme_on_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/fasterRouteCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="3秒后自动消失"
                android:textColor="@color/theme_on_primary"
                android:alpha="0.8"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="点击切换"
                android:textColor="@color/theme_on_primary"
                android:alpha="0.8"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 左侧控制栏 -->
    <LinearLayout
        android:id="@+id/leftControlBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="18dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/lockButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="锁定"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/closure_unlock_btn"
            android:tint="@color/player_control_icon" />
    </LinearLayout>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 丢帧信息 -->
        <TextView
            android:id="@+id/droppedFramesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 主控制行：左 = 暂停/播放 + 下一集；中 = 当前时间 + 进度条 + 总时长；右 = 画面比例 + 全屏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="播放/暂停"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/dkplayer_ic_action_pause"
                android:tint="@color/player_control_icon" />

            <!-- 清晰度入口：竖屏显示在播放键右侧（40dp，与底栏其他图标同规格），横屏由代码置 GONE；
                 点击仍走 showVideoInfo()（当前只有视频信息弹窗，无清晰度切换逻辑）。
                 默认 GONE，由 updateOrientationUI() 的竖屏分支打开 -->
            <ImageButton
                android:id="@+id/qualityButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="清晰度"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hd"
                android:tint="@color/player_control_icon"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="下一集"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/album_play_next"
                android:tint="@color/player_control_icon"
                android:visibility="gone" />

            <!-- 时间文字固定 58dp 宽 + 等宽数字：无论是 59:59 还是 01:00:00，宽度都不变，
                 中间 weight=1 的进度条容器不会被重新测量，拖动时进度条长度恒定 -->
            <TextView
                android:id="@+id/currentPositionText"
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="00:00"
                android:textColor="@color/player_control_text"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">

                <!-- 进度条：总高固定 14dp（拖动时高度不变、不 reflow），轨道 4dp 在其中垂直居中，
                     12dp 滑块不被裁；缓冲段仍走同一条 drawable 的 secondaryProgress 层，位于已播轨道下面 -->
                <SeekBar
                    android:id="@+id/progressSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:progressDrawable="@drawable/tencent_style_seekbar"
                    android:thumb="@drawable/tencent_style_thumb"
                    android:thumbOffset="0dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/durationText"
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="00:00"
                android:textColor="@color/player_control_text"
                android:textSize="13sp" />

            <!-- 画面比例入口已收到「⋯ 更多」菜单，底栏只保留一个展开图标（fullscreenButton） -->
            <ImageButton
                android:id="@+id/fullscreenButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="全屏"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/dkplayer_ic_action_fullscreen1"
                android:tint="@color/player_control_icon" />
        </LinearLayout>

        <!-- 加载日志显示 -->
        <TextView
            android:id="@+id/loadingLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:alpha="0.6"
            android:visibility="gone" />

        <!-- 竖屏专用项：清晰度/选集/下载/解析/倍速（横屏下由代码置 GONE，这里默认隐藏） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/screenshotButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="截屏"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/dkplayer_ic_action_close"
                android:tint="@color/player_control_icon_dim"
                android:visibility="gone" />

            <Button
                android:id="@+id/episodeButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="选集"
                android:textColor="@color/player_control_icon_dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/downloadButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="下载"
                android:textColor="@color/player_control_icon_dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/parseRecordButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="解析"
                android:textColor="@color/player_control_icon_dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/speedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="倍速"
                android:textColor="@color/player_control_icon_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 状态提示（缓冲中 / 切换线路 / 解析中 …）：绝对定位浮层（FrameLayout 子项），
         不参与底部控制栏的测量与高度，只压在画面上；显示时由代码把底边抬到底栏上沿 -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:background="@drawable/gesture_hint_background"
        android:backgroundTint="#B3101010"
        android:elevation="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 拖动进度条时的拇指时间气泡：绝对定位浮层（FrameLayout 子项），不参与底栏高度/布局。
         visibility 由 onStartTrackingTouch/onStopTrackingTouch 控制，位置由 translationX/Y 跟随拇指；
         贴底栏上沿，与 volumeBrightnessLayout / qualityHintText（都在顶部或屏幕中央）不重叠 -->
    <TextView
        android:id="@+id/seekTimeBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/gesture_hint_background"
        android:backgroundTint="#CC101010"
        android:elevation="6dp"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 播放结束卡片：播放器 STATE_ENDED 时显示「已播完」+ 重播 / 下一集（无下一集时隐藏） -->
    <LinearLayout
        android:id="@+id/playbackEndedCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/gesture_hint_background"
        android:backgroundTint="#CC101010"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="18dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/playbackEndedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="已播完"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <android.widget.Button
                android:id="@+id/endedReplayButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/gesture_hint_background"
                android:backgroundTint="#3DFFFFFF"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingTop="0dp"
                android:paddingEnd="18dp"
                android:paddingBottom="0dp"
                android:text="重播"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <android.widget.Button
                android:id="@+id/endedNextEpisodeButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/gesture_hint_background"
                android:backgroundTint="#3DFFFFFF"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingTop="0dp"
                android:paddingEnd="18dp"
                android:paddingBottom="0dp"
                android:text="下一集"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

