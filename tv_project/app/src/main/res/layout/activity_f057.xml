<?xml version="1.0" encoding="utf-8"?>
<!--
  「缓冲与并发策略」页 · 沿用外观主题页 / 功能页的 FlClash 视觉语言：
  卡片层 + 16dp 圆角，预设卡片选中态用 bg_mode_card_selected（2dp primary 描边），未选中用 bg_mode_card。
  颜色只走 colors.xml 的 theme_* / surface_* 语义 token，这里不出现任何十六进制。
  电视没有触摸屏：预设卡片、四个数值输入框、保存 / 恢复默认都可聚焦，
  nextFocus* 串成 返回 → 省流 → 均衡 → 激进 → 缓冲 → 最小 → 最大 → 并发 → 保存 → 恢复默认 一条线。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <!-- 标题行：返回 + 页标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/f057_action_back"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/f057PresetSaver"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/theme_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/f057_title"
                android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f057_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 小节：档位预设 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f057_section_preset"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_gap">

                <!-- 省流 -->
                <LinearLayout
                    android:id="@+id/f057PresetSaver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_mode_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_min_height"
                    android:nextFocusDown="@id/f057PresetBalanced"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/f057_preset_saver"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                        <TextView
                            android:id="@+id/f057PresetSaverDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/f057CheckSaver"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_primary"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- 均衡 -->
                <LinearLayout
                    android:id="@+id/f057PresetBalanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_mode_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_min_height"
                    android:nextFocusDown="@id/f057PresetAggressive"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/f057_preset_balanced"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                        <TextView
                            android:id="@+id/f057PresetBalancedDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/f057CheckBalanced"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_primary"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- 激进 -->
                <LinearLayout
                    android:id="@+id/f057PresetAggressive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_mode_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_min_height"
                    android:nextFocusDown="@id/f057BufferInput"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/f057_preset_aggressive"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                        <TextView
                            android:id="@+id/f057PresetAggressiveDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/f057CheckAggressive"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_primary"
                        android:visibility="invisible" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/f057_preset_hint"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：自定义四项 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f057_section_custom"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- 缓冲时长 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f057_label_buffer"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                <EditText
                    android:id="@+id/f057BufferInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_input"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/f057_hint_buffer"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLines="1"
                    android:nextFocusDown="@id/f057MinInput"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textSize="14sp" />

                <!-- 最小缓冲 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/f057_label_min"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                <EditText
                    android:id="@+id/f057MinInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_input"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/f057_hint_min"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLines="1"
                    android:nextFocusDown="@id/f057MaxInput"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textSize="14sp" />

                <!-- 最大缓冲 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/f057_label_max"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                <EditText
                    android:id="@+id/f057MaxInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_input"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/f057_hint_max"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLines="1"
                    android:nextFocusDown="@id/f057ConnInput"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textSize="14sp" />

                <!-- 并发连接数 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/f057_label_conn"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                <EditText
                    android:id="@+id/f057ConnInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_input"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/f057_hint_conn"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLines="1"
                    android:nextFocusDown="@id/f057SaveButton"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/f057_range_note"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：等效参数 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f057_section_preview"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- 当前已保存的配置 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f057_current"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/f057ActivePreset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/theme_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/f057CurrentSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                    android:textColor="@color/theme_text_primary" />

                <TextView
                    android:id="@+id/f057PreviewStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:lineSpacingExtra="3dp"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                    android:textColor="@color/theme_text_secondary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/card_gap"
                    android:layout_marginBottom="@dimen/card_gap"
                    android:background="@color/theme_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f057_preview_label"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <!-- 等效参数说明：等宽字体，方便直接抄进播放器 -->
                <TextView
                    android:id="@+id/f057PreviewParams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_input"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:minHeight="160dp"
                    android:padding="12dp"
                    android:textColor="@color/theme_text_primary"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 保存：主动作，正文用主题色 -->
        <LinearLayout
            android:id="@+id/f057SaveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/bg_card_surface"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/list_row_min_height"
            android:nextFocusDown="@id/f057ResetButton"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/f057_action_save"
                android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                android:textColor="@color/theme_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/f057_action_hint"
                android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
        </LinearLayout>

        <!-- 恢复默认：次要动作 -->
        <LinearLayout
            android:id="@+id/f057ResetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/bg_card_surface"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/list_row_min_height"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/f057_action_reset"
                android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/f057_action_hint"
                android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:text="@string/f057_engine_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
