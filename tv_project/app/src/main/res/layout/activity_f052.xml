<?xml version="1.0" encoding="utf-8"?>
<!--
  「搜索范围过滤」页 · 沿用 FlClash 视觉语言
  自上而下：关键字框 → 类型多选（4 个按钮，可同时选中）→ 时长四档（单选）
  → 结果汇总 / 生效条件 / 结果列表。
  三个条件 AND 叠加，任何一处改动都立即重算；结果行由 Activity 运行时生成，布局里只留容器。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/f052_title"
            android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f052_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 一、关键字 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f052_section_keyword"
                    android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/keywordInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/search_input_bg"
                        android:hint="@string/f052_keyword_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:nextFocusDown="@id/btnClear"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/theme_text_primary"
                        android:textColorHint="@color/theme_text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnClear"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/card_gap"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:minWidth="96dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/f052_clear"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 二、类型多选 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f052_section_type"
                    android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnTypeMovie"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f052_type_movie"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnTypeSeries"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f052_type_series"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnTypeShort"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f052_type_short"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnTypeLocal"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f052_type_local"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/typeSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_mode_row"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="@string/f052_type_all"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 三、时长四档（单选） -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f052_section_duration"
                    android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnBandAny"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_mode_card_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f052_band_any"
                        android:textColor="@color/theme_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnBand10"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f052_band_within_10"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnBand45"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f052_band_10_to_45"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnBandOver"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f052_band_over_45"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/durationSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_mode_row"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="@string/f052_duration_all"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 四、结果与生效条件 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f052_section_result"
                        android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

                    <TextView
                        android:id="@+id/resultCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f052_result_count_idle"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                        android:textColor="@color/theme_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/conditionValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_mode_row"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:text="@string/f052_condition_idle"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                    android:textColor="@color/theme_text_primary" />

                <TextView
                    android:id="@+id/conditionDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/f052_condition_and_idle"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <TextView
                    android:id="@+id/resultEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_tag_inset"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:text="@string/f052_empty"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/resultContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/bg_mode_row"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="@string/f052_hint_sample"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>