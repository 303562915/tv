<?xml version="1.0" encoding="utf-8"?>
<!--
  「投屏会话控制」页 · 沿用外观主题页 / 功能页的 FlClash 视觉语言：
  卡片层 + 16dp 圆角，焦点态靠 bg_card_surface 的 surface_inset 填充表达，不额外描边。
  颜色只走 colors.xml 的 theme_* / surface_* 语义 token，这里不出现任何十六进制。
  电视没有触摸屏：返回、两个输入框、九个动作、折叠头都可聚焦，
  nextFocus* 串成 返回 → 控制地址 → 设备名 → 播放 → 重播 → 暂停 → 停止 → 进度 → 跳转 →
  音量输入 → 减 → 设置 → 加 → 刷新 → 回执。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <!-- 标题行：返回 + 页标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/f062_action_back"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/f062ControlUrl"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/theme_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/f062_title"
                android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f062_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 小节：会话 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f062_section_session"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f062_label_control_url"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                <EditText
                    android:id="@+id/f062ControlUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_input"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/f062_hint_control_url"
                    android:imeOptions="actionNext"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="1"
                    android:nextFocusDown="@+id/f062DeviceName"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/f062_label_device"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                <EditText
                    android:id="@+id/f062DeviceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_input"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/f062_hint_device"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:nextFocusDown="@+id/f062Play"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textSize="@dimen/text_body" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/card_gap"
                    android:layout_marginBottom="@dimen/card_gap"
                    android:background="@color/theme_divider" />

                <!-- 当前会话状态三行：播放态 / 音量 / 进度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f062_label_state"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/f062StateValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/theme_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f062_label_volume"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/f062VolumeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                        android:textColor="@color/theme_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f062_label_reltime"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/f062RelTimeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                        android:textColor="@color/theme_text_primary" />
                </LinearLayout>

                <!-- 会话身份：设备名 · controlURL -->
                <TextView
                    android:id="@+id/f062SessionValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                    android:textColor="@color/theme_text_secondary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/card_gap"
                    android:layout_marginBottom="@dimen/card_gap"
                    android:background="@color/theme_divider" />

                <!-- 状态行：成功 / 部分成功 / 失败，颜色由代码按结果切换 -->
                <TextView
                    android:id="@+id/f062StatusLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                    android:textColor="@color/theme_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：控制 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f062_section_control"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- 四个主动作排一行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/f062Play"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/list_row_min_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/f062SeekInput"
                        android:nextFocusRight="@+id/f062Restart"
                        android:text="@string/f062_action_play"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_primary" />

                    <TextView
                        android:id="@+id/f062Restart"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/list_row_min_height"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/f062SeekInput"
                        android:nextFocusLeft="@+id/f062Play"
                        android:nextFocusRight="@+id/f062Pause"
                        android:text="@string/f062_action_restart"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/f062Pause"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/list_row_min_height"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/f062SeekInput"
                        android:nextFocusLeft="@+id/f062Restart"
                        android:nextFocusRight="@+id/f062Stop"
                        android:text="@string/f062_action_pause"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/f062Stop"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/list_row_min_height"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/f062SeekInput"
                        android:nextFocusLeft="@+id/f062Pause"
                        android:text="@string/f062_action_stop"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/f062_action_hint"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/card_gap"
                    android:layout_marginBottom="@dimen/card_gap"
                    android:background="@color/theme_divider" />

                <!-- 进度跳转 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f062_label_seek"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/f062SeekInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dialog_input"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:hint="@string/f062_hint_seek"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1"
                        android:nextFocusRight="@+id/f062SeekButton"
                        android:padding="12dp"
                        android:singleLine="true"
                        android:textColor="@color/theme_text_primary"
                        android:textColorHint="@color/theme_text_secondary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/f062SeekButton"
                        android:layout_width="96dp"
                        android:layout_height="@dimen/list_row_min_height"
                        android:layout_marginStart="@dimen/card_gap"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/f062VolumeInput"
                        android:text="@string/f062_action_seek"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/card_gap"
                    android:layout_marginBottom="@dimen/card_gap"
                    android:background="@color/theme_divider" />

                <!-- 音量：输入绝对值 + 减 / 设置 / 加 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f062_label_volume_set"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/f062VolumeInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dialog_input"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:hint="@string/f062_hint_volume"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1"
                        android:nextFocusRight="@+id/f062VolumeDown"
                        android:padding="12dp"
                        android:singleLine="true"
                        android:textColor="@color/theme_text_primary"
                        android:textColorHint="@color/theme_text_secondary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/f062VolumeDown"
                        android:layout_width="56dp"
                        android:layout_height="@dimen/list_row_min_height"
                        android:layout_marginStart="@dimen/card_gap"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/f062Refresh"
                        android:nextFocusRight="@+id/f062VolumeSet"
                        android:text="@string/f062_action_volume_down"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_primary" />

                    <TextView
                        android:id="@+id/f062VolumeSet"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/list_row_min_height"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/f062Refresh"
                        android:nextFocusLeft="@+id/f062VolumeDown"
                        android:nextFocusRight="@+id/f062VolumeUp"
                        android:text="@string/f062_action_volume_set"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/f062VolumeUp"
                        android:layout_width="56dp"
                        android:layout_height="@dimen/list_row_min_height"
                        android:layout_marginStart="@dimen/card_gap"
                        android:background="@drawable/bg_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/f062Refresh"
                        android:nextFocusLeft="@+id/f062VolumeSet"
                        android:text="@string/f062_action_volume_up"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/card_gap"
                    android:layout_marginBottom="@dimen/card_gap"
                    android:background="@color/theme_divider" />

                <!-- 回读设备：状态被遥控器从另一端改过之后靠它纠偏 -->
                <LinearLayout
                    android:id="@+id/f062Refresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_min_height"
                    android:nextFocusDown="@+id/f062ResponseToggle"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f062_action_refresh"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f062_action_hint"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：最近一次 SOAP 响应 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f062_section_response"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- 折叠头：点一下展开 / 收起回执原文 -->
                <LinearLayout
                    android:id="@+id/f062ResponseToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_min_height"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f062_response_title"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/f062ResponseArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/theme_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/f062_response_hint"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <!-- 回执原文：等宽字体，默认折叠 -->
                <TextView
                    android:id="@+id/f062ResponseBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_input"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:minHeight="64dp"
                    android:padding="12dp"
                    android:textIsSelectable="true"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:text="@string/f062_engine_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
