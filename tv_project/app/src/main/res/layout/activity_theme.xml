<?xml version="1.0" encoding="utf-8"?>
<!--
  「外观主题」页 · FlClash 视觉语言
  选中态只用 2dp primary 描边 + 右侧对勾表达，不用 primaryContainer 铺底。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/themeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_setting"
            android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/theme_header_hint"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 小节：外观模式 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/theme_section_mode"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_gap">

                <!--
                  三张等宽「选择卡」横向一排（layout_weight 3 等分），与下方主题色板同一套交互：
                  选中 = 2dp primary 描边 + 右上角对勾；圆角 8dp（radius_sm），不用 16dp 胶囊圆角。
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- 跟随系统 -->
                    <LinearLayout
                        android:id="@+id/nightModeFollowSystem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_theme_mode_card_selected"
                        android:clickable="true"
                        android:contentDescription="跟随系统：深浅色随系统设置自动切换"
                        android:focusable="true"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="start|top"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_phone"
                                android:tint="@color/theme_text_primary" />

                            <ImageView
                                android:id="@+id/checkFollowSystem"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="top|end"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/theme_mode_follow"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/theme_mode_follow_desc"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <!-- 浅色模式 -->
                    <LinearLayout
                        android:id="@+id/nightModeOff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_theme_mode_card"
                        android:clickable="true"
                        android:contentDescription="浅色模式：始终使用浅色外观"
                        android:focusable="true"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="start|top"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_brightness"
                                android:tint="@color/theme_text_primary" />

                            <ImageView
                                android:id="@+id/checkLightMode"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="top|end"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_primary"
                                android:visibility="invisible" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/theme_mode_light"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/theme_mode_light_desc"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <!-- 深色模式 -->
                    <LinearLayout
                        android:id="@+id/nightModeOn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_theme_mode_card"
                        android:clickable="true"
                        android:contentDescription="深色模式：始终使用深色外观"
                        android:focusable="true"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="start|top"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_moon"
                                android:tint="@color/theme_text_primary" />

                            <ImageView
                                android:id="@+id/checkDarkMode"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="top|end"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_primary"
                                android:visibility="invisible" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/theme_mode_dark"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/theme_mode_dark_desc"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：主题色 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/theme_section_color"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!--
                  主题色板容器：每行 4 个、用 layout_weight 等分宽度（代码里动态建行），
                  单项 = 圆点 + 颜色名，圆点尺寸固定 dp、宽度自适应，窄屏不溢出。
                -->
                <LinearLayout
                    android:id="@+id/themeColorGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_mode_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <View
                        android:id="@+id/currentColorPreview"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/color_circle" />

                    <TextView
                        android:id="@+id/currentColorName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/theme_color_default_blue"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_current_color_label"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
          小节：效果预览
          色板下方这块预览卡是「所见即所得」的判据：背景块 / 主色文字 / 主色按钮
          都由 ThemeActivity 用**刚选中的颜色**直接在代码里上色（不读静态的
          @color/theme_primary —— 那是编译期常量，换色不会跟着变），所以点一下
          色板这里立刻变色，不用退出重进。
        -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/theme_section_preview"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- 背景块：整块铺当前主色（圆角在代码里按选中色重画） -->
                <View
                    android:id="@+id/themePreviewBlock"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_mode_row" />

                <!-- 一行主色文字 -->
                <TextView
                    android:id="@+id/themePreviewText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/theme_preview_text"
                    android:textColor="@color/theme_primary"
                    android:textSize="15sp" />

                <!-- 主色按钮（纯展示，不接收点击） -->
                <TextView
                    android:id="@+id/themePreviewButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/theme_preview_button"
                    android:textColor="@color/theme_on_primary"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>