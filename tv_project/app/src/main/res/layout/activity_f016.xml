<?xml version="1.0" encoding="utf-8"?>
<!--
  「双语双行字幕合成」页 · 沿用功能页的 FlClash 视觉语言：
  page 背景 + MaterialCardView 卡片，圆角与间距全走 dimens，颜色全走 colors.xml 语义 token。
  两个输入框预填示例 SRT，遥控器 D-Pad 直链：主输入 → 副输入 → 合成按钮。
  结果区是代码里动态填的容器，本身不可聚焦，焦点不会掉进长列表里出不来。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/f016_title"
            android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f016_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 小节：字幕源 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f016_section_source"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f016_primary_label"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f016_primary_role"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                </LinearLayout>

                <EditText
                    android:id="@+id/f016PrimaryInput"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card_surface"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="top|start"
                    android:imeOptions="flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:nextFocusDown="@id/f016SecondaryInput"
                    android:nextFocusForward="@id/f016SecondaryInput"
                    android:padding="12dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f016_secondary_label"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f016_secondary_role"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                </LinearLayout>

                <EditText
                    android:id="@+id/f016SecondaryInput"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card_surface"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="top|start"
                    android:imeOptions="flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:nextFocusDown="@id/f016MergeButton"
                    android:nextFocusForward="@id/f016MergeButton"
                    android:nextFocusUp="@id/f016PrimaryInput"
                    android:padding="12dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/f016_input_hint"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <LinearLayout
                    android:id="@+id/f016MergeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_card_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_min_height"
                    android:nextFocusDown="@id/f016PrimaryInput"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f016_merge_action"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                        android:textColor="@color/theme_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f016_merge_hint"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：合成统计 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f016_section_stats"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/f016StatTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/theme_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/f016_stat_total_label"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/f016StatOverlap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/theme_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/f016_stat_overlap_label"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/f016StatSingle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/theme_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/f016_stat_single_label"
                            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/f016StatDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <TextView
                    android:id="@+id/f016RuleNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/f016_rule_note"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：合成结果 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f016_section_result"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/f016ResultList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_gap" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:text="@string/f016_player_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>