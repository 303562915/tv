<?xml version="1.0" encoding="utf-8"?>
<!--
  「最近添加与最近播放」页 · 沿用 FlClash 视觉语言（卡片层 + 16dp 圆角）。
  两个数据源用顶部两个切换按钮选，横向轨道里的卡片由 F026Activity 按引擎结果动态构建，
  布局只留标题区、切换条、上限档位、示例数据操作、摘要行、轨道容器和空态提示。
  电视没有触摸屏：所有可操作控件 focusable，切换按钮之间显式串好 nextFocus 路径。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/f026_title"
            android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f026_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 数据源切换：两个按钮互斥，选中态靠背景描边区分（Activity 里改背景） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:text="@string/f026_section_source"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSourceAdded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btnSourcePlayed"
                android:text="@string/f026_action_source_added"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btnSourcePlayed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_gap"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btnSourceAdded"
                android:text="@string/f026_action_source_played"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- 上限档位：5 / 10 / 20 三档，选中态同上 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:text="@string/f026_section_limit"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLimit5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btnLimit10"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btnLimit10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_gap"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btnLimit5"
                android:nextFocusRight="@id/btnLimit20"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btnLimit20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_gap"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btnLimit10"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- 示例数据操作：横向可滚，窄屏也不挤成一团 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLoadSamples"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="@string/f026_action_load_samples"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/btnClearLibrary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/card_gap"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="@string/f026_action_clear"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 横向轨道：卡片由 Activity 逐条挂进来 -->
        <HorizontalScrollView
            android:id="@+id/railScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:clipToPadding="false"
            android:focusable="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/railContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:text="@string/f026_empty_added"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:background="@drawable/bg_mode_row"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="@string/f026_hint"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
