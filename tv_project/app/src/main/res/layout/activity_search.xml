<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/theme_background"
    android:fitsSystemWindows="true">

    <!-- 顶部工具条：page 底（透明），标题 24sp bold 左对齐 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/page_toolbar_height"
            android:background="@android:color/transparent"
            android:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 返回：44dp 触摸区，图标 24dp -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="返回"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_back"
                    app:tint="@color/theme_text_primary" />

                <!-- 搜索框：inset 填充 + 胶囊圆角，无描边，高 40dp -->
                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/search_input_bg"
                    android:hint="白日提灯"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="@dimen/text_body"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btnVoiceSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="语音搜索"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/theme_text_secondary" />

                <!-- 主操作：实心 primary + onPrimary -->
                <TextView
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_primary_button"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/search_submit"
                    android:textColor="@color/theme_on_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 历史记录区域 -->
    <LinearLayout
        android:id="@+id/historySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginEnd="@dimen/page_margin"
        android:orientation="vertical"
        android:background="@color/surface_card"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/history"
                android:textColor="@color/theme_text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="清空历史"
                android:gravity="center"
                android:minWidth="44dp"
                android:minHeight="32dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/common_clear"
                android:textColor="@color/theme_text_secondary"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

        <!-- 搜索历史列表 -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            app:singleLine="false" />

    </LinearLayout>

    <!-- Tab切换：榜单 -->
    <LinearLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="@dimen/card_gap"
        android:layout_marginEnd="@dimen/page_margin"
        android:orientation="vertical"
        android:background="@color/surface_card"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabRanking"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/search_tab_ranking"
                android:textColor="@color/theme_text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- 找片Tab暂时隐藏 -->
            <TextView
                android:id="@+id/tabSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/search_tab_find"
                android:textColor="@color/theme_text_secondary"
                android:textSize="@dimen/text_title"
                android:gravity="center"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Tab下划线指示器 -->
        <View
            android:id="@+id/tabIndicator"
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_gravity="start"
            android:layout_marginStart="16dp"
            android:background="@drawable/tab_indicator_bg" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 搜索结果列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/theme_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="96dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            tools:listitem="@layout/item_video" />

        <!-- 空状态：图标 + 一句说明，居中，不彩色 -->
        <LinearLayout
            android:id="@+id/tvNoResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_history"
                app:tint="@color/theme_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/search_no_results"
                android:textColor="@color/theme_text_secondary"
                android:textSize="@dimen/text_body" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!--
          联想下拉：放在结果区这一层 FrameLayout 的最上面，用覆盖的方式压在列表之上。
          为什么不放进外层竖排 LinearLayout 占位：占位会让下面的 RecyclerView 每次弹出/收起
          都重新测量一次，滚动位置和榜单分批游标都会被打断；覆盖式只在视觉上盖住前几行，
          收起后列表原样不动。
          位置就在搜索框正下方——一旦开始输入，tabLayout 与 historySection 都已经 GONE 了。
          行由 SearchActivity 运行时生成（行数随候选变化，不新增布局文件），这里只留容器。
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSuggestions"
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/card_gap"
            android:layout_marginEnd="@dimen/page_margin"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="8dp"
            app:contentPadding="0dp">

            <LinearLayout
                android:id="@+id/suggestionPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</LinearLayout>