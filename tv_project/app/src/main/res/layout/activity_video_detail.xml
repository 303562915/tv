<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:fitsSystemWindows="false"
        android:background="@android:color/transparent">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            app:contentScrim="@color/theme_primary"
            app:titleEnabled="true"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            android:fitsSystemWindows="false">

            <!-- 封面/海报大卡：圆角 24dp，无阴影 -->
            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/page_margin"
                android:background="@drawable/bg_cover_xl"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:fitsSystemWindows="false"
                app:layout_collapseMode="parallax"
                android:contentDescription="视频封面" />

            <!-- 添加渐变遮罩 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_top"
                app:layout_collapseMode="parallax" />

            <!--
              折叠后的标题压在 contentScrim 上：
              contentScrim 由透明改成 theme_primary，折叠标题走 AppBar 的 Dark.ActionBar overlay（白字），
              否则标题会浮在封面上、深色封面配深色字等于没有标题。
            -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/page_toolbar_height"
                android:fitsSystemWindows="false"
                app:titleTextColor="@android:color/white"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- id 是必需的：分批显示后要按估算位置回滚，没有引用就拿不到滚动容器 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/page_margin">

            <!--
              失败态：单独一块，不再把错误塞进 tvDescription（原来会把简介覆盖掉）。
              可点 = 重试，所以既要 clickable 也要 focusable，别让无障碍摸不到。
            -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_gap"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:padding="@dimen/card_padding"
                android:textColor="@color/theme_accent"
                android:textSize="@dimen/text_body"
                android:visibility="gone"
                tools:text="加载失败，点我重试"
                tools:visibility="visible" />

            <!-- 重试按钮：复用主按钮底，48dp 触摸区 -->
            <Button
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="@dimen/card_gap"
                android:background="@drawable/bg_primary_button"
                android:text="重试"
                android:textColor="@color/theme_on_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- 信息区：卡片装标题与元信息，页面上浮一级 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfo"
                style="@style/Widget.TVPlayer.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold"
                        tools:text="视频标题" />

                    <!--
                      标题下方的操作行：收藏 / 分享。
                      用 TextView 而不是 Button：MaterialButton 会接管 android:background，
                      自绘的圆角底会被覆盖，这里只要「48dp 高 + 圆角 + surface_block 底」的次级按钮外观。
                    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnFavorite"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/vd_action_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="收藏"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:id="@+id/btnShare"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/vd_action_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="分享"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="@dimen/text_body" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="@dimen/text_caption"
                        tools:text="2026" />

                    <TextView
                        android:id="@+id/tvArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="@dimen/text_caption"
                        tools:text="地区" />

                    <TextView
                        android:id="@+id/tvType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="@dimen/text_caption"
                        tools:text="类型" />

                    <TextView
                        android:id="@+id/tvDirector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="@dimen/text_caption"
                        tools:text="导演" />

                    <TextView
                        android:id="@+id/tvActor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="@dimen/text_caption"
                        tools:text="主演" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="@dimen/text_body"
                        tools:text="视频描述" />

                    <!-- 这一屏唯一的主操作：实心 primary + onPrimary -->
                    <Button
                        android:id="@+id/btnPlay"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/card_padding"
                        android:background="@drawable/bg_primary_button"
                        android:text="播放"
                        android:textColor="@color/theme_on_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 选集：分组标题 + 线路 Tab + 格子 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEpisodes"
                style="@style/Widget.TVPlayer.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <!-- 标题行：左侧「选集」，右侧「上次看到第 N 集」 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="选集"
                            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

                        <TextView
                            android:id="@+id/tvLastWatched"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="end"
                            android:textColor="@color/theme_accent"
                            android:textSize="@dimen/text_caption"
                            android:visibility="gone"
                            tools:text="上次看到第 12 集"
                            tools:visibility="visible" />

                    </LinearLayout>

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:background="@android:color/transparent"
                        app:tabMode="scrollable"
                        app:tabIndicatorColor="@color/theme_primary"
                        app:tabSelectedTextColor="@color/theme_primary"
                        app:tabTextColor="@color/theme_text_secondary"
                        app:tabIndicatorHeight="2dp"
                        app:tabTextAppearance="@style/TabTextAppearance"
                        app:tabRippleColor="@null" />

                    <!-- 选集列表 - 自适应高度 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvEpisodes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:listitem="@layout/item_episode" />

                    <!-- 分批显示：超过 60 集才出现，点一下展开 / 收起 -->
                    <TextView
                        android:id="@+id/tvEpisodeExpand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="12dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/theme_accent"
                        android:textSize="@dimen/text_body"
                        android:visibility="gone"
                        tools:text="展开全部（共 120 集）"
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
