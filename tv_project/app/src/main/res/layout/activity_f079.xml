<?xml version="1.0" encoding="utf-8"?>
<!--
  「首启动引导」页 · 沿用功能页的 FlClash 视觉语言：
  卡片层 + 16dp 圆角，焦点态靠 bg_card_surface / bg_secondary_button 的 inset 填充表达，不额外描边。
  颜色只走 colors.xml 的 theme_* / surface_* 语义 token，这里不出现任何十六进制。

  结构：标题行（返回 + 页名）→ 一句说明 → 引导卡片（图标井 + 页标题 + 正文 + 圆点 + 页码）
        → 翻页行（上一条 / 下一条，最后一页换成「开始使用」）→ 跳过 → 重新查看引导 → 状态行。

  五页共用这一套模板：卡片里的图标、标题、正文由 F079Activity.render 按 F079Engine.page(index)
  逐个换掉，静态布局只放一次骨架，不写五个 layout。

  电视遥控器：
  · 返回 → 引导卡片，进页面后由代码把焦点交给「下一条」；
  · 「上一条」在第一页置灰不可点（alpha 降），但仍留在焦点链里，不会出现「焦点卡住」；
  · 「跳过」在最后一页改成 INVISIBLE（不是 GONE），焦点链不塌；
  · 圆点只做视觉指示，isFocusable=false、不可点，不抢方向键。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <!-- 标题行：返回 + 页名 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/f079_action_back"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/f079Dots"
                android:nextFocusRight="@id/f079ResetButton"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/theme_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/f079_title"
                android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f079_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 引导卡片：图标井 + 页标题 + 正文 + 圆点 + 页码 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_icon_well"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/f079Icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/f079_page_icon_a11y"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="@color/theme_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/f079PageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

                <TextView
                    android:id="@+id/f079PageBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/f079Dots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/f079PageIndex"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 翻页行：上一条 / 下一条（最后一页换成开始使用） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/f079PrevButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:nextFocusRight="@id/f079NextButton"
                android:text="@string/f079_action_prev"
                android:textColor="@color/theme_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/f079NextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:nextFocusRight="@id/f079SkipButton"
                android:text="@string/f079_action_next"
                android:textColor="@color/theme_on_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 跳过：一句话说明跳过也不会丢功能，只是不再自动弹 -->
        <TextView
            android:id="@+id/f079SkipButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusRight="@id/f079ResetButton"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/f079_action_skip"
            android:textColor="@color/theme_text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- 重新查看引导：先 reset 状态，再把页面拉回第一页 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/f079ResetButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:minWidth="140dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/f079_action_reset"
                android:textColor="@color/theme_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/f079Status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/theme_text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:lineSpacingExtra="2dp"
            android:text="@string/f079_footer_note"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>