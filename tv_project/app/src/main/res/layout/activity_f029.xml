<?xml version="1.0" encoding="utf-8"?>
<!--
  「收藏标签与分组」页 · FlClash 视觉语言
  标签管理（重命名 / 删除）＋ 标签筛选条 ＋ 收藏列表（每条自带 tag chips）。
  三块内容都由 F029Activity 动态填充，布局里只留容器与说明文案。
  电视没有触摸屏：动态生成的控件一律 focusable，方向键可达。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/f029_title"
            android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f029_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 卡片一：标签管理 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f029_section_tags"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f029_tags_hint"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <TextView
                    android:id="@+id/tagCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="15sp"
                    tools:text="共 5 个标签" />

                <LinearLayout
                    android:id="@+id/tagRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tagEmptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="20dp"
                    android:text="@string/f029_tags_empty"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片二：收藏与筛选 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f029_section_favorites"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f029_favorites_hint"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <!-- 筛选条：全部 + 每个标签（带条数） -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/filterChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/favSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="15sp"
                    tools:text="当前显示全部 6 条收藏" />

                <LinearLayout
                    android:id="@+id/favRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/favEmptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="20dp"
                    android:text="@string/f029_fav_empty"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
