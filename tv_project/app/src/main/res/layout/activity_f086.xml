<?xml version="1.0" encoding="utf-8"?>
<!--
  「关于」页 · 结构对照 unicanta 的 AboutScreen（Compose）一比一翻译成 View 体系：

  1. AppHero：图标块 + 应用名 + 版本行（开发版带 dev 构建号）+ 安装时间 + 一句话定位；
  2. UpdateCard：整张卡片就是点击区（右侧「立即检查」只是状态字样，不单独接收点击）——
     空闲提示 / 检查中 / 已是最新 / 发现新版本 / 失败原因，失败再点一次就是重试；
  3. UpdateChannelCard：一行「更新渠道 + 下拉选择稳定版 / 开发版」，遥控器确认展开；
  4. 自动下载安装开关（SwitchCompat + switch_thumb_color / switch_track_color，与倍速面板同一套美化）；
  5. 权限来源：Root（面具 / KernelSU / APatch）/ Shizuku / Stellar / Dhizuku / 自带安装器五行，
     行由代码按探测结果生成，标出哪条「使用中」、哪条未授权（点击直接去申请）；
  6. 下载页 / 源码仓库两个外链（源码仓库是最后一组）。

  行几何与「我的」页同一套 token（对照 unicanta SettingsItem.kt：
  GroupInset 13 / GroupCorner 12 / RowPaddingH 14 / RowPaddingV 9 / RowMinHeight 44 /
  LeadingIcon 19 / LeadingGap 11 / TrailingIcon 18），组间距 group_gap，组标题距底
  group_title_gap；卡片自己圆角 group_corner，行底用 bg_profile_row 的焦点/按下色。
  卡片本身是焦点目标时，行底靠 android:duplicateParentState 承接卡片焦点态。

  电视遥控器操作：焦点链  返回 → 检查更新 → 渠道下拉 → 自动安装 →
  权限来源各行（首尾行由代码接上下一焦点）→ 下载页 → 打开仓库 → 更新记录（末位，不再向下延伸）。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/f086Scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="0dp"
        android:paddingBottom="96dp">

        <!-- 标题行：返回 + 页标题 -->
        <!-- 容器横向不再留 padding，卡片只靠 group_inset 定位，与「我的」页横向位置一致 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/f086_action_back"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/f086UpdateCard"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/theme_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/f086_title"
                android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />
        </LinearLayout>

        <!-- ===== AppHero（对照 unicanta AboutScreen.AppHero） ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/card_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 图标块：主题色圆角块 + 应用图形（与桌面图标同一形状语言） -->
            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="62dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_icon_tile" />

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/f086_title"
                    android:src="@drawable/ic_app_glyph"
                    app:tint="@color/theme_on_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f086_app_name"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/f086VersionValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/f086UpdatedValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/f086_tagline"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== UpdateCard（对照 unicanta AboutScreen.UpdateCard） ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/f086UpdateCard"
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/btnBack"
            android:nextFocusDown="@id/f086ChannelSpinner"
            app:cardCornerRadius="@dimen/group_corner"
            android:minHeight="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_row"
                android:duplicateParentState="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f086_check_update"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:id="@+id/f086UpdateProgress"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginEnd="6dp"
                            android:indeterminateTint="@color/theme_primary"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/f086UpdateStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:text="@string/f086_check_hint"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/f086UpdateAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:importantForAccessibility="no"
                    android:text="@string/f086_check_action"
                    android:textColor="@color/theme_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 更新渠道：一行「标题 + 下拉选择」（对照 unicanta AboutScreen.UpdateChannelCard） ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            app:cardCornerRadius="@dimen/group_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/f086_channel_label"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="@dimen/text_title" />

                <Spinner
                    android:id="@+id/f086ChannelSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/row_leading_gap"
                    android:background="@drawable/bg_dialog_input"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:foreground="@drawable/bg_focus_ring"
                    android:minWidth="128dp"
                    android:nextFocusDown="@id/f086AutoInstall"
                    android:nextFocusUp="@id/f086UpdateCard"
                    android:popupBackground="@drawable/bg_dialog_input" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 自动下载安装开关（对照 unicanta AboutScreen.ToggleCard） ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            app:cardCornerRadius="@dimen/group_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/f086_auto_install"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="@dimen/text_title" />

                <!-- 开关与倍速面板同一个美化样式：拇指/轨道按选中态取色 -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/f086AutoInstall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/row_leading_gap"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/f086ChannelSpinner"
                    android:nextFocusDown="@id/f086DownloadCard"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 权限来源（自动安装走哪条通道，逐条标状态） ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/f086PrivilegeCard"
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            app:cardCornerRadius="@dimen/group_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f086_privilege_title"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/f086_privilege_hint"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="11sp" />

                <!-- 五行（Root / Shizuku / Stellar / Dhizuku / 自带安装器）由代码按探测结果生成 -->
                <LinearLayout
                    android:id="@+id/f086PrivilegeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 外链：下载页 / 源码仓库（对照 unicanta AboutScreen.LinkCard） ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/f086DownloadCard"
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/f086AutoInstall"
            android:nextFocusDown="@id/f086RepoButton"
            app:cardCornerRadius="@dimen/group_corner"
            android:minHeight="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_row"
                android:duplicateParentState="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f086_download_page"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="@string/f086_download_url"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/row_trailing_icon"
                    android:layout_height="@dimen/row_trailing_icon"
                    android:layout_marginStart="@dimen/row_leading_gap"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/theme_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/f086RepoCard"
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            app:cardCornerRadius="@dimen/group_corner">

            <LinearLayout
                android:id="@+id/f086RepoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_row"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:nextFocusDown="@id/f086ChangelogRow"
                android:nextFocusUp="@id/f086DownloadCard"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f086_action_repo"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="@string/f086_repo_url"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/row_trailing_icon"
                    android:layout_height="@dimen/row_trailing_icon"
                    android:layout_marginStart="@dimen/row_leading_gap"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/theme_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
          ===== 更新记录 =====
          一行 12sp 次要色文字，点开弹最近 5 个版本的一句话说明（数据是本地常量
          Changelog.entries，不发网络请求）。它是页面末位，遥控器再往下不延伸。
        -->
        <TextView
            android:id="@+id/f086ChangelogRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            android:background="@drawable/bg_profile_row"
            android:clickable="true"
            android:contentDescription="@string/f086_changelog_hint"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:nextFocusDown="@null"
            android:nextFocusUp="@id/f086RepoButton"
            android:paddingStart="@dimen/row_padding_h"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/row_padding_h"
            android:paddingBottom="12dp"
            android:text="@string/f086_changelog"
            android:textColor="@color/theme_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>