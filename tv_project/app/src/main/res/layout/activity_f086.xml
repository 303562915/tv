<?xml version="1.0" encoding="utf-8"?>
<!--
  「关于」页 · 结构对照 unicanta 的 AboutScreen（Compose）一比一翻译成 View 体系：

  1. AppHero：图标块 + 应用名 + 版本行（开发版带 dev 构建号）+ 安装时间 + 一句话定位；
  2. UpdateCard：整行可点的「检查更新」——空闲提示 / 检查中 / 已是最新 / 发现新版本 /
     失败原因（点名网络、配额、超时），失败再点一次就是重试；
  3. UpdateChannelCard：稳定版 / 开发版 两个渠道芯片（遥控器确认切换），
     提示行由 F086Activity 按当前渠道填 f086_check_hint_channel；
  4. 自动下载安装开关；
  5. 下载页 / 源码仓库两个外链；
  6. 第三方依赖 + 许可证全文（本项目自有的开源合规区，unicanta 没有对应物，保留）。

  行几何与「我的」页同一套 token（对照 unicanta SettingsItem.kt：
  GroupInset 13 / GroupCorner 12 / RowPaddingH 14 / RowPaddingV 9 / RowMinHeight 44 /
  LeadingIcon 19 / LeadingGap 11 / TrailingIcon 18），组间距 group_gap，组标题距底
  group_title_gap；卡片自己圆角 group_corner，行底用 bg_profile_row 的焦点/按下色。
  卡片本身是焦点目标时，行底靠 android:duplicateParentState 承接卡片焦点态。

  电视遥控器操作：焦点链  返回 → 检查更新 → 稳定版 → 开发版 → 自动安装 →
  下载页 → 打开仓库 → 许可证长文本区；依赖行与说明文字不抢焦点。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/f086Scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="0dp"
        android:paddingBottom="96dp">

        <!-- 标题行：返回 + 页标题 -->
        <!-- 容器横向不再留 padding，卡片只靠 group_inset 定位，与「我的」页横向位置一致 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/f086_action_back"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/f086UpdateCard"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/theme_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/f086_title"
                android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />
        </LinearLayout>

        <!-- ===== AppHero（对照 unicanta AboutScreen.AppHero） ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/card_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 图标块：主题色圆角块 + 应用图形（与桌面图标同一形状语言） -->
            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="62dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_icon_tile" />

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/f086_title"
                    android:src="@drawable/ic_app_glyph"
                    app:tint="@color/theme_on_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f086_app_name"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/f086VersionValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/f086UpdatedValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/f086_tagline"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== UpdateCard（对照 unicanta AboutScreen.UpdateCard） ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/f086UpdateCard"
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/btnBack"
            android:nextFocusDown="@id/f086ChannelStable"
            app:cardCornerRadius="@dimen/group_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_row"
                android:duplicateParentState="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f086_check_update"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:id="@+id/f086UpdateProgress"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginEnd="6dp"
                            android:indeterminateTint="@color/theme_primary"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/f086UpdateStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:text="@string/f086_check_hint"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/f086UpdateAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/f086_check_action"
                    android:textColor="@color/theme_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 更新渠道（对照 unicanta AboutScreen.UpdateChannelCard） ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            app:cardCornerRadius="@dimen/group_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f086_channel_label"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body"
                    android:textColor="@color/theme_text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/f086_channel_hint"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/group_gap"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/f086ChannelStable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_channel_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:minHeight="@dimen/row_min_height"
                        android:nextFocusDown="@id/f086ChannelDev"
                        android:nextFocusLeft="@id/f086ChannelDev"
                        android:nextFocusRight="@id/f086ChannelDev"
                        android:nextFocusUp="@id/f086UpdateCard"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/f086_channel_stable"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/f086ChannelDev"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/group_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_channel_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:minHeight="@dimen/row_min_height"
                        android:nextFocusDown="@id/f086AutoInstall"
                        android:nextFocusLeft="@id/f086ChannelStable"
                        android:nextFocusRight="@id/f086ChannelStable"
                        android:nextFocusUp="@id/f086ChannelStable"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/f086_channel_dev"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 自动下载安装开关（对照 unicanta AboutScreen.ToggleCard） ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            app:cardCornerRadius="@dimen/group_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f086_auto_install"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/f086_auto_install_hint"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/f086AutoInstall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/row_leading_gap"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/f086ChannelDev"
                    android:nextFocusDown="@id/f086DownloadCard" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 外链：下载页 / 源码仓库（对照 unicanta AboutScreen.LinkCard） ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/f086DownloadCard"
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/f086AutoInstall"
            android:nextFocusDown="@id/f086RepoButton"
            app:cardCornerRadius="@dimen/group_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_row"
                android:duplicateParentState="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f086_download_page"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="@string/f086_download_url"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/row_trailing_icon"
                    android:layout_height="@dimen/row_trailing_icon"
                    android:layout_marginStart="@dimen/row_leading_gap"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/theme_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/f086RepoCard"
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/group_gap"
            android:layout_marginEnd="@dimen/group_inset"
            app:cardCornerRadius="@dimen/group_corner">

            <LinearLayout
                android:id="@+id/f086RepoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_row"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:nextFocusDown="@id/f086LicenseScroll"
                android:nextFocusUp="@id/f086DownloadCard"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/f086_action_repo"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="@string/f086_repo_url"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/row_trailing_icon"
                    android:layout_height="@dimen/row_trailing_icon"
                    android:layout_marginStart="@dimen/row_leading_gap"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/theme_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 第三方依赖（本项目自有） ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/group_title_gap"
            android:paddingStart="@dimen/row_padding_h"
            android:paddingEnd="@dimen/row_padding_h"
            android:text="@string/f086_section_deps"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginEnd="@dimen/group_inset"
            app:cardCornerRadius="@dimen/group_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <!-- 条数由代码按 F086Engine.deps().size 填 -->
                <TextView
                    android:id="@+id/f086DepsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/theme_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 依赖行容器：代码按清单顺序逐行生成（名字 / 版本 · 许可证 / 上游地址） -->
                <LinearLayout
                    android:id="@+id/f086DepList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 许可证全文（本项目自有） ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/group_title_gap"
            android:paddingStart="@dimen/row_padding_h"
            android:paddingEnd="@dimen/row_padding_h"
            android:text="@string/f086_section_license"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/group_inset"
            android:layout_marginEnd="@dimen/group_inset"
            app:cardCornerRadius="@dimen/group_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f086_license_intro"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <!-- 一行统计：几项依赖、各自什么许可证，由 F086Engine.licenseSummary() 生成 -->
                <TextView
                    android:id="@+id/f086LicenseSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/theme_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 可滚动长文本区：固定高度，遥控器聚焦后用上下键在区内滚动 -->
                <ScrollView
                    android:id="@+id/f086LicenseScroll"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="@dimen/group_gap"
                    android:background="@color/surface_inset"
                    android:fillViewport="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/f086RepoButton"
                    android:nestedScrollingEnabled="true"
                    android:overScrollMode="never"
                    android:padding="12dp"
                    android:scrollbars="vertical">

                    <TextView
                        android:id="@+id/f086LicenseText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="12sp" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>