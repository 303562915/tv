<?xml version="1.0" encoding="utf-8"?>
<!--
  竖屏连播的「一集」页面。
  分层（由下到上）：
    1. PlayerView            视频画面，铺满，自带控制器关闭（app:use_controller=false），所有控件自己画
    2. topScrim / bottomScrim 上下渐变遮罩，保证白字在任何画面上都看得清
    3. centerIcon            单击画面后浮出的播放/暂停大图标
    4. loadingView           加载中转圈（STATE_BUFFERING）
    5. errorPanel            本集播放失败的可点重试浮层
    6. rightRail             抖音那排竖排按钮：头像、点赞、评论、收藏、分享、拍同款，再往下是选集/倍速/线路
    7. bottomInfo            剧名 / 第N集 / 线路 / 细进度条 / 时间
    8. dragHintPill          「下滑松手锁定 2 倍速」胶囊提示（只在按住后向下拖够阈值时出现）
    9. zoomBar               双指缩小后的底部控制条（✕ / -5s / 播放暂停 / +5s / 倍速）
  这一页里所有交互都在 ShortDramaPlayerPageHolder 里接线，布局只负责摆位置。

  关于 app:resize_mode
    默认用 zoom（画面铺满、超出部分裁掉），这是抖音竖屏的常态观感；
    用户双指捏合缩小才切到 fit（画面完整收进屏幕、上下留黑边），
    黑边区域正好留给 zoomBar，所以控制条放在画面下方而不是画面中心。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        app:resize_mode="zoom"
        app:shutter_background_color="@android:color/black"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- 顶部渐变：只为了衬返回箭头，高度不用太高 -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/gradient_top"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- 底部渐变：底部信息区的可读性全压在这一层上 -->
    <View
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- 单击画面后浮出的播放/暂停图标：不参与无障碍焦点（状态已由播放器本身表达） -->
    <ImageView
        android:id="@+id/centerIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerInside"
        android:src="@drawable/sd_ic_play" />

    <ProgressBar
        android:id="@+id/loadingView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@android:color/white"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 失败浮层：整块可点，点一下就是重试 -->
    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/sd_bg_panel_dark"
        android:clickable="true"
        android:contentDescription="本集播放失败，点击重试"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        tools:visibility="visible"
        android:minHeight="48dp">

        <TextView
            android:id="@+id/tvErrorTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本集播放失败，点击重试"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sdp_switch_source_hint"
            android:textColor="@color/player_control_icon_dim"
            android:textSize="@dimen/text_caption"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!--
      右侧竖排按钮，顺序对齐抖音：
      头像（+关注）→ 点赞 → 评论 → 收藏 → 分享 → 拍同款 → 选集 → 倍速 → 线路。
      评论 / 收藏 / 分享 / 拍同款 都是本地占位，点了只 toast「暂未开放」，所以下面不写数字，
      只写功能名 —— 写 0 或写假数字都会让人以为这里真的有点赞/评论数据。
      图标统一 36dp + 10dp 间距：条目变多以后 44dp 会把整列顶出屏幕上沿。
    -->
    <LinearLayout
        android:id="@+id/rightRail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="118dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 头像 + 关注：头像用剧封面裁圆，纯占位（不请求用户资料） -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="54dp">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/sd_bg_avatar_ring"
                android:clickable="true"
                android:clipToOutline="true"
                android:contentDescription="剧集头像"
                android:focusable="true"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvFollowBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/sd_bg_follow_badge"
                android:clickable="true"
                android:contentDescription="关注"
                android:focusable="true"
                android:gravity="center"
                android:paddingBottom="2dp"
                android:text="+"
                android:textColor="@color/theme_on_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 点赞：双击画面也会走这里，计数纯本地占位 -->
        <LinearLayout
            android:id="@+id/btnLike"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:contentDescription="点赞"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/sd_bg_circle_scrim"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/sd_ic_heart" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                tools:text="12" />
        </LinearLayout>

        <!-- 评论：本地占位，只显示功能名 -->
        <LinearLayout
            android:id="@+id/btnComment"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:contentDescription="评论"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/sd_bg_circle_scrim"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/sd_ic_comment" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:text="@string/sdp_comment"
                android:textColor="@android:color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 收藏：本地占位 -->
        <LinearLayout
            android:id="@+id/btnFavorite"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:contentDescription="收藏"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/sd_bg_circle_scrim"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/sd_ic_star" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:text="@string/favorite"
                android:textColor="@android:color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 分享：本地占位 -->
        <LinearLayout
            android:id="@+id/btnShare"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:contentDescription="分享"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/sd_bg_circle_scrim"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/sd_ic_share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:text="@string/common_share"
                android:textColor="@android:color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 拍同款：本地占位，圆形 + 加号 -->
        <LinearLayout
            android:id="@+id/btnShoot"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:contentDescription="拍同款"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/sd_bg_circle_scrim"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/sd_ic_camera" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:text="@string/sdp_shoot_same"
                android:textColor="@android:color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 选集 -->
        <LinearLayout
            android:id="@+id/btnEpisodes"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:contentDescription="选集"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/sd_bg_circle_scrim"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/sd_ic_episodes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:text="@string/common_episodes"
                android:textColor="@android:color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 倍速：圆圈里直接显示当前倍速文字，比抽象图标更直观；锁定状态下这里会变成「2.0x / 锁定」 -->
        <LinearLayout
            android:id="@+id/btnSpeed"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:contentDescription="切换倍速"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:minHeight="48dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/sd_bg_circle_scrim">

                <TextView
                    android:id="@+id/tvSpeedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="1.0x"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:text="@string/player_backup_speed"
                android:textColor="@android:color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 换线路：只有一条线路时由代码 GONE -->
        <LinearLayout
            android:id="@+id/btnLine"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:contentDescription="切换线路"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/sd_bg_circle_scrim"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/sd_ic_switch_line" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:text="@string/sdp_line"
                android:textColor="@android:color/white"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 底部信息区 -->
    <LinearLayout
        android:id="@+id/bottomInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/tvDramaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="总裁的替身新娘" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEpisodeMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                tools:text="第12集 / 共80集" />

            <TextView
                android:id="@+id/tvLineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/sd_bg_panel_dark"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/player_control_icon_dim"
                android:textSize="11sp"
                tools:text="线路一" />
        </LinearLayout>

        <!--
          极细进度条：抖音是「纯展示、不能拖」，也没有 00:12 / 01:30 那种时间文字
          （短剧一集一两分钟，拖动带来的收益远小于误触代价）。
          所以这里设成不可点击/不可聚焦，触摸事件直接穿给根布局，
          单击暂停、双击点赞、上下滑翻页都照常生效。
        -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:clickable="false"
            android:enabled="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:max="1000"
            android:maxHeight="2dp"
            android:minHeight="2dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressDrawable="@drawable/sd_seekbar_progress"
            android:splitTrack="false"
            android:thumb="@null" />

    </LinearLayout>

    <!--
      下滑锁定倍速的胶囊提示：只在「按住画面后向下拖过阈值」时浮出，
      位置放在控制条上方，避免和底部信息区、右侧栏互相压字。
    -->
    <TextView
        android:id="@+id/dragHintPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="188dp"
        android:background="@drawable/sd_bg_hint_pill"
        android:importantForAccessibility="no"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="∨ 下滑松手锁定 2 倍速"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!--
      双指缩小后的底部控制条：✕ / -5s / 播放暂停 / +5s / 倍速。
      抖音这条是贴屏幕最底的「一行纯图标」，没有深色背景条，也不悬在半空，
      所以这里 marginBottom 交给代码按 systemBars inset 补，不用猜 dp
      （不同机型手势条 / 三键导航高度差很多，写死会被压住或悬空）。
    -->
    <LinearLayout
        android:id="@+id/zoomBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/btnZoomClose"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="收起控制条并恢复全屏"
            android:focusable="true"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/sd_ic_close" />

        <ImageView
            android:id="@+id/btnBack5"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="后退5秒"
            android:focusable="true"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/sd_ic_back5" />

        <ImageView
            android:id="@+id/btnBarPlay"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="暂停"
            android:focusable="true"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/sd_ic_pause" />

        <ImageView
            android:id="@+id/btnForward5"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="前进5秒"
            android:focusable="true"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/sd_ic_forward5" />

        <TextView
            android:id="@+id/btnBarSpeed"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="切换倍速"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="1.0x"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
