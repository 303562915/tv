<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_page">

    <!-- 播放器容器 -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.35"
        android:background="@android:color/black">

        <!-- 手势控制层 -->
        <View
            android:id="@+id/gestureView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 播放器视图 -->
        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:show_buffering="when_playing"
            app:use_controller="false" />

        <!-- 加载提示 -->
        <LinearLayout
            android:id="@+id/loadingView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/player_backup_buffering"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- 手势反馈提示 -->
        <TextView
            android:id="@+id/gestureHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/gesture_hint_background"
            android:padding="16dp"
            android:textColor="@color/theme_text_primary"
            android:textSize="@dimen/text_title"
            android:visibility="gone" />

        <!-- 错误提示 -->
        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_title"
            android:visibility="gone" />

        <!-- 顶部工具栏 -->
        <LinearLayout
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_top"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="返回"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_revert" />

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_title" />

                <ImageButton
                    android:id="@+id/menuButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="菜单"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_more" />
            </LinearLayout>
        </LinearLayout>

        <!-- 底部控制栏 - 腾讯视频风格单行布局 -->
        <LinearLayout
            android:id="@+id/bottomControlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <!-- 播放/暂停按钮 -->
            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="播放/暂停"
                android:padding="6dp"
                android:src="@android:drawable/ic_media_play" />

            <!-- 当前时间 -->
            <TextView
                android:id="@+id/currentPositionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="02:21"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption" />

            <!-- 进度条 -->
            <SeekBar
                android:id="@+id/progressSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:progressDrawable="@drawable/tencent_style_seekbar"
                android:thumb="@drawable/tencent_style_thumb"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:thumbOffset="0dp" />

            <!-- 总时长 -->
            <TextView
                android:id="@+id/durationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="12:39"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption" />

            <!-- 旋转屏幕按钮 -->
            <ImageButton
                android:id="@+id/fullscreenButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="全屏"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_crop" />

            <!-- 下一集按钮 - 竖屏时隐藏 -->
            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="下一集"
                android:padding="6dp"
                android:src="@android:drawable/ic_media_next"
                android:visibility="gone" />

            <!-- 选集按钮 - 竖屏时隐藏 -->
            <Button
                android:id="@+id/episodeButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/common_episodes"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 左侧锁定按钮 -->
        <!-- 左侧锁定按钮 -->
        <LinearLayout
            android:id="@+id/leftControlBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/lockButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="锁定"
                android:padding="4dp"
                android:src="@drawable/closure_unlock_btn"
                android:tint="@android:color/white" />
        </LinearLayout>
    </FrameLayout>

    <!-- 竖屏底部内容区域 - 主要用于日志显示 -->
    <ScrollView
        android:id="@+id/portraitBottomContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.65"
        android:background="@color/surface_page">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 日志显示区域 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/portrait_play_log"
                android:textColor="@color/theme_text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/logDisplayText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/theme_text_secondary"
                android:textSize="@dimen/text_caption"
                android:fontFamily="monospace"
                android:text="@string/portrait_log_waiting" />

            <!-- 视频标题和信息 -->
            <TextView
                android:id="@+id/videoTitleBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/theme_text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/videoInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/theme_text_secondary"
                android:textSize="13sp" />

            <!-- 功能按钮区域 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <!-- 日志 -->
                    <LinearLayout
                        android:id="@+id/logButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_info_details"
                            app:tint="@color/theme_primary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/portrait_log_label"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <!-- 投屏 -->
                    <LinearLayout
                        android:id="@+id/castButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_share"
                            app:tint="@color/theme_primary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/portrait_cast"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <!-- 快源 -->
                    <LinearLayout
                        android:id="@+id/sourceButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="@color/theme_primary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/portrait_quick_source"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <!-- 外控 -->
                    <LinearLayout
                        android:id="@+id/externalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_send"
                            app:tint="@color/theme_primary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/portrait_external_control"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <!-- 离线 -->
                    <LinearLayout
                        android:id="@+id/offlineButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_save"
                            app:tint="@color/theme_primary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/portrait_offline"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 视频源选择器 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/source"
                android:textColor="@color/theme_text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/videoSourceSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- 选集列表 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/common_episodes"
                android:textColor="@color/theme_text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodeRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxHeight="300dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
