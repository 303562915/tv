<?xml version="1.0" encoding="utf-8"?>
<!--
  仿 FlClash 悬浮胶囊底栏（NavigationDock）：
  - 窄胶囊居中悬浮：宽度 = count*86dp + 16dp（3 项 = 274dp），绝不横跨全屏；
    宽度上限由 FloatingNavDock.onMeasure 计算，这里只给 wrap_content + 居中约束。
  - 胶囊高 62dp、内边距 4dp、左右 21dp（nav_edge_margin）由 dock 自己的 padding 承担。
  - 悬浮阴影由 FloatingNavDock 自绘（对应 FlClash dockShadows）。
  - 视口底部间距 max(21dp, navigationBarInset) 由 FloatingNavDock 的 insets 监听处理。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/navDock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 本地视频入口在「我的」页（rowLocalVideo），这里不再挂常显悬浮按钮 -->
    <com.tv.ball.presentation.nav.FloatingNavDock
        android:id="@+id/navDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>