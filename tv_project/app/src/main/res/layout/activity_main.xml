<?xml version="1.0" encoding="utf-8"?>
<!-- 仿 FlClash 悬浮胶囊底栏：bar 62dp、内边距 4dp、左右 21dp、阴影预留 8dp -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/navShadowRoom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabOpenLocalVideo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/open_local_video"
        android:src="@drawable/ic_nav_local_video"
        app:backgroundTint="?attr/colorPrimaryContainer"
        app:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/navShadowRoom"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="?attr/colorPrimary"
        app:tint="?attr/colorOnPrimaryContainer" />

    <!-- 阴影预留区（8dp）+ 悬浮胶囊 -->
    <FrameLayout
        android:id="@+id/navShadowRoom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="21dp"
        android:layout_marginBottom="13dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/navCapsule"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            app:cardBackgroundColor="@color/nav_capsule"
            app:cardCornerRadius="31dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/nav_capsule_stroke"
            app:strokeWidth="0.5dp">

            <com.tv.ball.presentation.nav.FloatingNavDock
                android:id="@+id/navDock"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
