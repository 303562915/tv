<?xml version="1.0" encoding="utf-8"?>
<!-- 仿 FlClash 悬浮胶囊底栏：bar 62dp、内边距 4dp、左右 21dp、无阴影 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/navCapsule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabOpenLocalVideo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="14dp"
        android:contentDescription="@string/open_local_video"
        android:src="@drawable/ic_nav_local_video"
        app:backgroundTint="?attr/colorPrimaryContainer"
        app:elevation="0dp"
        app:borderWidth="0dp"
        app:layout_constraintBottom_toTopOf="@+id/navCapsule"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="?attr/colorPrimary"
        app:tint="?attr/colorOnPrimaryContainer" />

    <!-- 悬浮胶囊：无阴影 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navCapsule"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="21dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/nav_capsule"
        app:cardCornerRadius="31dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.tv.ball.presentation.nav.FloatingNavDock
            android:id="@+id/navDock"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
