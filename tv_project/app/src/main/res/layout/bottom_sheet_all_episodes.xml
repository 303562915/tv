<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- 标题栏（顶部不再保留拖动把手，标题直接贴到顶部内边距） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选集"
            android:textColor="@color/theme_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/dkplayer_ic_action_close"
            android:tint="@color/theme_text_primary"
            android:scaleType="fitCenter"
            android:padding="2dp" />
    </LinearLayout>

    <!-- Tab切换线路 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:tabMode="scrollable"
        app:tabIndicatorColor="@color/theme_primary"
        app:tabSelectedTextColor="@color/theme_primary"
        app:tabTextColor="@color/theme_text_secondary"
        app:tabIndicatorHeight="2dp"
        app:tabTextAppearance="@style/TabTextSmall"
        app:tabRippleColor="@null" />

    <!-- 选集网格列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/episodesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="400dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</LinearLayout>
