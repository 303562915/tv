<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 滚动容器 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 播放器容器 -->
            <FrameLayout
                android:id="@+id/playerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/black">

                <!-- 包含原来的播放器布局 -->
                <include
                    android:id="@+id/rootView"
                    layout="@layout/activity_video_player" />

            </FrameLayout>

            <!-- 视频详情区域（仅竖屏显示） -->
            <LinearLayout
                android:id="@+id/videoDetailSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_page"
                android:visibility="gone">

                <!-- 标题区域 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 标题 -->
                    <TextView
                        android:id="@+id/videoTitleDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="视频标题"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- 视频信息（播放量、评分等） -->
                    <TextView
                        android:id="@+id/videoInfoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="8.5分 · 8118播放"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="@dimen/text_caption" />

                </LinearLayout>

                <!-- 功能按钮行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:gravity="center">

                    <!-- 推荐 -->
                    <LinearLayout
                        android:id="@+id/likeButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="48dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_thumb_up_black_24dp"
                            android:tint="@color/theme_text_secondary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="推荐"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 加追 -->
                    <LinearLayout
                        android:id="@+id/favoriteButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="48dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_favorite_border_black_24dp"
                            android:tint="@color/theme_text_secondary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="加追"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 下载 -->
                    <LinearLayout
                        android:id="@+id/downloadButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="48dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_file_download_black_24dp"
                            android:tint="@color/theme_text_secondary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="下载"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 投屏 -->
                    <LinearLayout
                        android:id="@+id/castButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="48dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_cast_black_24dp"
                            android:tint="@color/theme_text_secondary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="投屏"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 分享 -->
                    <LinearLayout
                        android:id="@+id/shareButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="48dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_share_black_24dp"
                            android:tint="@color/theme_text_secondary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="分享"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 分隔线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/theme_divider" />

                <!-- 选集区域 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 选集标题 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="选集"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <!-- 选集列表 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/episodeRecyclerViewDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:clipToPadding="false" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
