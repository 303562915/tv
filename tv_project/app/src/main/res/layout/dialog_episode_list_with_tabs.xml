<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#4D1F1F1F">
    <!-- 30% 透明度的深灰色背景: alpha=0.3, 0.3*255=77=0x4D -->

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="#4D1F1F1F">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选集"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/dkplayer_ic_action_close"
            android:tint="@android:color/white"
            android:scaleType="fitCenter"
            android:padding="4dp" />
    </LinearLayout>

    <!-- 线路选择 TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/sourceTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4D1F1F1F"
        app:tabMode="scrollable"
        app:tabIndicatorColor="@color/theme_primary"
        app:tabSelectedTextColor="@android:color/white"
        app:tabTextColor="#AAAAAA"
        app:tabIndicatorHeight="3dp"
        app:tabTextAppearance="@style/TabTextAppearance"
        app:tabRippleColor="@null"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <!-- 选集列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/episodeRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

</LinearLayout>
