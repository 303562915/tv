<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_card">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选集"
            android:textColor="@color/theme_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/dkplayer_ic_action_close"
            android:tint="@color/theme_text_primary"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 线路选择 TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/sourceTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:tabMode="scrollable"
        app:tabIndicatorColor="@color/theme_primary"
        app:tabSelectedTextColor="@color/theme_primary"
        app:tabTextColor="@color/theme_text_secondary"
        app:tabIndicatorHeight="3dp"
        app:tabTextAppearance="@style/TabTextAppearance"
        app:tabRippleColor="@null"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <!-- 选集列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/episodeRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

</LinearLayout>
