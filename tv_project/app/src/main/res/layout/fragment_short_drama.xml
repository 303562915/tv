<?xml version="1.0" encoding="utf-8"?>
<!--
  首页「免费短剧」Tab 的列表页。
  本次改动的三处布局调整（都是为了和列表页 ShortDramaActivity 对齐）：
  1. RecyclerView 外面包一层竖向 LinearLayout + FrameLayout：骨架列表要盖在真实网格上，
     底部还要固定一条三态 footer（加载中 / 没有更多了 / 加载失败点我重试）。
  2. 新增 skeletonRecycler：首屏 / 切分类时铺 6 个占位卡片，替掉原来「一片空白」的加载态；
     列数与真实网格同一套（见 ShortDramaFragment.resolveGridColumns）。
  3. emptyView 从 ConstraintLayout 的直接子 View 移进 FrameLayout（layout_gravity=center），
     只覆盖内容区，不再盖住 Tab 和 footer。
  注意：SwipeRefresh 的子 View 变成 LinearLayout 后，「列表已经滚下去也会被判成可下拉」，
  必须在代码里给 setOnChildScrollUpCallback（见 ShortDramaFragment.setupSwipeRefresh），
  否则往下滚到底会误触发下拉刷新。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/theme_background"
        app:tabMode="scrollable"
        app:tabTextColor="@color/theme_text_secondary"
        app:tabSelectedTextColor="@color/theme_accent"
        app:tabIndicatorColor="@color/theme_accent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 内容区：真实网格 / 骨架 / 空态三选一，互相叠在同一块区域上 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:clipToPadding="false" />

                <!-- 首屏骨架：6 个占位卡片，和真实网格同一套 LayoutManager，列数一致才不跳位 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/skeletonRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:clipToPadding="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/emptyView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="暂无短剧"
                    android:textSize="16sp"
                    android:textColor="@color/theme_text_secondary"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- 三态 footer：加载中… / 没有更多了 / 加载失败，点我重试（文案与可点状态都在代码里切） -->
            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/theme_text_secondary"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
