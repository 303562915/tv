<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="播放设置"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text_primary"
        android:paddingBottom="16dp" />

    <!-- 画面比例 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="画面比例"
        android:textSize="14sp"
        android:textColor="@color/theme_text_secondary"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <RadioGroup
        android:id="@+id/aspectRatioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/aspectRatioFit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="自适应"
            android:textColor="@color/theme_text_primary"
            android:buttonTint="@color/theme_primary"
            android:checked="true" />

        <RadioButton
            android:id="@+id/aspectRatio169"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="16:9"
            android:textColor="@color/theme_text_primary"
            android:buttonTint="@color/theme_primary" />

        <RadioButton
            android:id="@+id/aspectRatio43"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4:3"
            android:textColor="@color/theme_text_primary"
            android:buttonTint="@color/theme_primary" />
    </RadioGroup>

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/aspectRatioFill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="铺满"
            android:textColor="@color/theme_text_primary"
            android:buttonTint="@color/theme_primary" />

        <RadioButton
            android:id="@+id/aspectRatioZoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="放大"
            android:textColor="@color/theme_text_primary"
            android:buttonTint="@color/theme_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/theme_divider"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- 播放倍速 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="播放倍速"
        android:textSize="14sp"
        android:textColor="@color/theme_text_secondary"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.5×"
            android:textSize="12sp"
            android:textColor="@color/theme_text_secondary" />

        <SeekBar
            android:id="@+id/speedSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.0×"
            android:textSize="12sp"
            android:textColor="@color/theme_text_secondary" />

        <TextView
            android:id="@+id/speedValueText"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="1.00×"
            android:textSize="14sp"
            android:textColor="@color/theme_primary"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 快速倍速按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/speed05Button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="0.5×"
            android:textSize="12sp"
            android:textColor="@color/theme_text_primary"
            android:background="@drawable/bg_dialog_button_secondary"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/speed075Button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="0.75×"
            android:textSize="12sp"
            android:textColor="@color/theme_text_primary"
            android:background="@drawable/bg_dialog_button_secondary"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/speed10Button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="1.0×"
            android:textSize="12sp"
            android:textColor="@color/theme_text_primary"
            android:background="@drawable/bg_dialog_button_secondary"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/speed125Button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="1.25×"
            android:textSize="12sp"
            android:textColor="@color/theme_text_primary"
            android:background="@drawable/bg_dialog_button_secondary"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/speed15Button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="1.5×"
            android:textSize="12sp"
            android:textColor="@color/theme_text_primary"
            android:background="@drawable/bg_dialog_button_secondary"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/speed20Button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="2.0×"
            android:textSize="12sp"
            android:textColor="@color/theme_text_primary"
            android:background="@drawable/bg_dialog_button_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/theme_divider"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- 重复播放模式 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="重复播放"
        android:textSize="14sp"
        android:textColor="@color/theme_text_secondary"
        android:paddingBottom="8dp" />

    <RadioGroup
        android:id="@+id/repeatModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/repeatModeOff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="关闭"
            android:textColor="@color/theme_text_primary"
            android:buttonTint="@color/theme_primary"
            android:checked="true" />

        <RadioButton
            android:id="@+id/repeatModeOne"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="单集循环"
            android:textColor="@color/theme_text_primary"
            android:buttonTint="@color/theme_primary" />

        <RadioButton
            android:id="@+id/repeatModeAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="列表循环"
            android:textColor="@color/theme_text_primary"
            android:buttonTint="@color/theme_primary" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/theme_divider"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- 片头片尾跳过 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="自动跳过片头"
            android:textSize="14sp"
            android:textColor="@color/theme_text_primary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/skipIntroSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="自动跳过片尾"
            android:textSize="14sp"
            android:textColor="@color/theme_text_primary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/skipOutroSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/theme_divider"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- 睡眠定时器：点击弹单选窗口改档位，右侧文字显示当前状态 -->
    <LinearLayout
        android:id="@+id/rowSleepTimer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="睡眠定时器"
            android:textSize="14sp"
            android:textColor="@color/theme_text_primary" />

        <TextView
            android:id="@+id/tvSleepTimerValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关闭"
            android:textSize="14sp"
            android:textColor="@color/theme_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/theme_divider"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- 下载按钮 -->
    <Button
        android:id="@+id/downloadButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="⬇️ 下载视频"
        android:textSize="16sp"
        android:textColor="@color/theme_on_primary"
        android:background="@drawable/bg_dialog_button_primary"
        android:layout_marginBottom="8dp" />

    <!-- 投屏按钮 -->
    <Button
        android:id="@+id/castButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="📺 投屏"
        android:textSize="16sp"
        android:textColor="@color/theme_text_primary"
        android:background="@drawable/bg_dialog_button_secondary" />
</LinearLayout>
