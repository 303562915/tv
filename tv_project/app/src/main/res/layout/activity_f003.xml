<?xml version="1.0" encoding="utf-8"?>
<!--
  「精确定位跳转」页 · 与外观主题页 / A-B 复读页同一套视觉语言：
  表面靠 card / block / inset 三档递进，焦点只用 2dp primary 描边表达（bg_focus_ring）。
  TV 无触摸屏：数字键盘做成一排可聚焦的按键，只拿 D-Pad 也能敲出 hh:mm:ss。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="96dp">

        <!-- 标题行：返回 + 页标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/f003_action_back"
                android:focusable="true"
                android:foreground="@drawable/bg_focus_ring"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/theme_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/f003_title"
                android:textAppearance="@style/TextAppearance.TVPlayer.PageTitle" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/f003_desc"
            android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

        <!-- 小节：时间码跳转 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f003_section_timecode"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/f003_label_input"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                <EditText
                    android:id="@+id/etTimecode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/search_input_bg"
                    android:focusable="true"
                    android:foreground="@drawable/bg_focus_ring"
                    android:hint="@string/f003_hint_timecode"
                    android:imeOptions="actionDone"
                    android:inputType="textVisiblePassword|textNoSuggestions"
                    android:maxLength="16"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/theme_text_primary"
                    android:textColorHint="@color/theme_text_secondary"
                    android:textSize="16sp" />

                <!-- 屏幕数字键：遥控器手里也能输入，tag 就是按下去要插入的字符 -->
                <LinearLayout
                    android:id="@+id/keypad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag="1"
                            android:text="1"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/card_gap"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag="2"
                            android:text="2"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/card_gap"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag="3"
                            android:text="3"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag="4"
                            android:text="4"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/card_gap"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag="5"
                            android:text="5"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/card_gap"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag="6"
                            android:text="6"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag="7"
                            android:text="7"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/card_gap"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag="8"
                            android:text="8"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/card_gap"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag="9"
                            android:text="9"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag=":"
                            android:text="@string/f003_key_colon"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/card_gap"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag="0"
                            android:text="0"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/card_gap"
                            android:layout_weight="1"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_focus_ring"
                            android:gravity="center"
                            android:tag="del"
                            android:text="@string/f003_key_delete"
                            android:textColor="@color/theme_text_primary"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnJump"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/card_padding"
                    android:background="@drawable/bg_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/bg_focus_ring"
                    android:gravity="center"
                    android:text="@string/f003_action_jump"
                    android:textColor="@color/theme_on_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 错误提示：非法输入必须原样说清原因，而不是静默不动 -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption"
                    android:textColor="@color/theme_error"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：快捷跳转 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f003_section_quick"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/btnPlus30"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/bg_focus_ring"
                    android:gravity="center"
                    android:text="@string/f003_action_plus30"
                    android:textColor="@color/theme_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnPlus5Min"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/card_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/bg_focus_ring"
                    android:gravity="center"
                    android:text="@string/f003_action_plus5min"
                    android:textColor="@color/theme_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnNearEnd"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/card_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/bg_focus_ring"
                    android:gravity="center"
                    android:text="@string/f003_action_near_end"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：片长设定 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f003_section_duration"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_min_height"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f003_label_duration"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f003_duration_default_value"
                        android:textColor="@color/theme_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etDuration"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/search_input_bg"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:hint="@string/f003_hint_duration"
                        android:imeOptions="actionDone"
                        android:inputType="textVisiblePassword|textNoSuggestions"
                        android:maxLength="16"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="@color/theme_text_primary"
                        android:textColorHint="@color/theme_text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnApplyDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="@dimen/card_gap"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:minWidth="92dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/f003_action_apply_duration"
                        android:textColor="@color/theme_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnDurationMinus5"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f003_action_duration_minus"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnDurationPlus5"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f003_action_duration_plus"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnDurationReset"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_focus_ring"
                        android:gravity="center"
                        android:text="@string/f003_action_duration_reset"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 小节：当前播放位置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="@string/f003_section_position"
            android:textAppearance="@style/TextAppearance.TVPlayer.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TVPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/f003_label_position"
                        android:textAppearance="@style/TextAppearance.TVPlayer.Body" />

                    <TextView
                        android:id="@+id/tvPosition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f003_position_default_value"
                        android:textColor="@color/theme_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbPosition"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:max="1000"
                    android:progress="0"
                    android:progressBackgroundTint="@color/surface_inset"
                    android:progressTint="@color/theme_primary" />

                <TextView
                    android:id="@+id/tvRemaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_tag_inset"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="@string/f003_remaining_default_value"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/f003_hint_ready"
                    android:textAppearance="@style/TextAppearance.TVPlayer.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
