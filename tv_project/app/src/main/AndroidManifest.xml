<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：在线视频播放 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 本地视频读取 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android TV：不强制要求触摸屏 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".VideoPlayerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TVPlayer"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.player.VideoPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.TVPlayer" />

        <activity
            android:name=".presentation.localvideo.LocalVideoActivity"
            android:exported="true"
            android:label="本地视频"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".presentation.localvideo.LocalVideoFolderActivity"
            android:exported="true"
            android:label="视频文件夹"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".presentation.favorite.FavoriteActivity"
            android:exported="true"
            android:label="我的收藏" />

        <activity
            android:name=".presentation.settings.ThemeActivity"
            android:exported="true"
            android:label="主题设置" />

    </application>

</manifest>
